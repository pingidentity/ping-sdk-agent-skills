/*
 * Application Constants & SDK Configuration
 *
 * INSTRUCTIONS:
 *   1. Place in client/constants.js
 *   2. Ensure your .env file is populated with the correct values
 *   3. This file is the single source of truth for SDK configuration
 *
 * Both the Journey client and the OIDC client share this CONFIG object.
 * The Journey client only needs serverConfig.wellknown — all other endpoints
 * (authenticate, sessions) are automatically derived from the well-known document.
 */

export const WELLKNOWN_URL = import.meta.env.VITE_WELLKNOWN_URL;
export const WEB_OAUTH_CLIENT = import.meta.env.VITE_WEB_OAUTH_CLIENT;
export const SCOPE = import.meta.env.VITE_SCOPE;
export const JOURNEY_LOGIN = import.meta.env.VITE_JOURNEY_LOGIN || 'Login';
export const JOURNEY_REGISTER = import.meta.env.VITE_JOURNEY_REGISTER || 'Registration';
export const DEBUGGER = import.meta.env.VITE_DEBUGGER_OFF !== 'true';
export const CENTRALIZED_LOGIN = import.meta.env.VITE_CENTRALIZED_LOGIN;
export const REDIRECT_URI = import.meta.env.VITE_REDIRECT_URI || `${window.location.origin}/callback.html`;
export const INIT_PROTECT = import.meta.env.VITE_INIT_PROTECT;
export const PINGONE_ENV_ID = import.meta.env.VITE_PINGONE_ENV_ID;

/**
 * Shared SDK configuration object.
 *
 * Used by both:
 *   - @forgerock/journey-client (for authentication flows)
 *   - @forgerock/oidc-client (for token management)
 */
export const CONFIG = {
  clientId: WEB_OAUTH_CLIENT,
  redirectUri: REDIRECT_URI,
  scope: SCOPE,
  serverConfig: {
    wellknown: WELLKNOWN_URL,
  },
};
