/*
 * Metadata Callback Component
 *
 * INSTRUCTIONS:
 *   Place in client/components/journey/metadata.jsx
 *
 * Handles: MetadataCallback
 *
 * Metadata callbacks carry server-provided data to the client. They are
 * typically used by the SDK internally (e.g., for WebAuthn) and do not
 * require user interaction. This component is included for completeness.
 *
 * SDK integration points:
 *   - callback.getData() → the metadata object from the server
 */

/**
 * @function Metadata — Non-visual component for metadata callbacks
 * @param {Object} props
 * @param {Object} props.callback — The callback object from PingAM
 */
export default function Metadata({ callback }) {
  // MetadataCallbacks carry server data and are typically not rendered.
  // Access the metadata via: callback.getData()
  return null;
}
