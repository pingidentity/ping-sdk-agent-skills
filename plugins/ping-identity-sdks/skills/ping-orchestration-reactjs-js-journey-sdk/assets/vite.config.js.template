/*
 * Vite configuration for a ReactJS app using the Ping Orchestration JavaScript SDK.
 *
 * INSTRUCTIONS:
 *   1. Place this file in the project root as vite.config.js
 *   2. Ensure @vitejs/plugin-react is installed
 *   3. The client/ folder is used as the Vite root (entry point)
 */

import { defineConfig, loadEnv } from 'vite';
import react from '@vitejs/plugin-react';

export default defineConfig(({ mode }) => {
  const env = loadEnv(mode, process.cwd(), '');
  const PORT = parseInt(env.VITE_PORT) || 8443;

  return {
    root: __dirname + '/client',
    publicDir: __dirname + '/public',
    envDir: __dirname,
    build: {
      outDir: __dirname + '/dist',
      emptyOutDir: true,
      reportCompressedSize: true,
      target: 'esnext',
    },
    server: {
      port: PORT,
      open: true,
      strictPort: true,
    },
    preview: {
      port: PORT,
    },
    plugins: [react()],
  };
});
