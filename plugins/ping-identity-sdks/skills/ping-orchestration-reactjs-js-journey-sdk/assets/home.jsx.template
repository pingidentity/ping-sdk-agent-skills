/*
 * Home View
 *
 * INSTRUCTIONS:
 *   Place in client/views/home.jsx
 *
 * Simple landing page that shows different content based on authentication state.
 */

import { useContext } from 'react';
import { Link } from 'react-router-dom';
import { OidcContext } from '../context/oidc.context';

/**
 * @function Home — React view for the home/landing page
 */
export default function Home() {
  const [{ isAuthenticated, username, email }] = useContext(OidcContext);

  if (isAuthenticated) {
    return (
      <div>
        <h1>Welcome, {username || 'User'}!</h1>
        {email && <p>Email: {email}</p>}
        <nav>
          <Link to="/logout">Sign Out</Link>
        </nav>
      </div>
    );
  }

  return (
    <div>
      <h1>Welcome</h1>
      <p>Please sign in to continue.</p>
      <nav>
        <Link to="/login" style={{ marginRight: '1rem' }}>
          Sign In
        </Link>
        <Link to="/register">Register</Link>
      </nav>
    </div>
  );
}
