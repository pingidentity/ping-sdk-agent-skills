@Composable
fun DeviceProfileCallbackField(field: DeviceProfileCallback, onNext: () -> Unit) {
    val currentOnNext by rememberUpdatedState(onNext)
    LaunchedEffect(field) {
        field.execute(DeviceProfileConfig { addCollector(HardwareCollector); addCollector(BrowserCollector); addCollector(PlatformCollector); addCollector(NetworkCollector); addCollector(TelephonyCollector) })
        currentOnNext()
    }
    Box(modifier = Modifier.fillMaxWidth(), contentAlignment = Alignment.Center) { CircularProgressIndicator() }
}

