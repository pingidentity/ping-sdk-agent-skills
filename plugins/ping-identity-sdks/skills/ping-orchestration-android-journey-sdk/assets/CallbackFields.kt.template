@Composable
fun TextOutputCallbackField(field: TextOutputCallback) {
    val color = when (field.messageType) { 2 -> MaterialTheme.colorScheme.error; 1 -> MaterialTheme.colorScheme.tertiary; else -> MaterialTheme.colorScheme.onSurface }
    Text(text = field.message, color = color, modifier = Modifier.padding(8.dp).fillMaxWidth())
}

@OptIn(ExperimentalMaterial3Api::class)
@Composable
fun ChoiceCallbackField(field: ChoiceCallback, onNodeUpdated: () -> Unit) {
    var expanded by remember { mutableStateOf(false) }
    var selectedIndex by remember(field) { mutableStateOf(field.defaultChoice) }
    ExposedDropdownMenuBox(expanded = expanded, onExpandedChange = { expanded = !expanded }) {
        OutlinedTextField(value = field.choices.getOrElse(selectedIndex) { "" }, onValueChange = {}, readOnly = true,
            label = { Text(field.prompt) }, trailingIcon = { ExposedDropdownMenuDefaults.TrailingIcon(expanded) },
            modifier = Modifier.fillMaxWidth().menuAnchor(MenuAnchorType.PrimaryNotEditable, true).padding(4.dp))
        ExposedDropdownMenu(expanded = expanded, onDismissRequest = { expanded = false }) {
            field.choices.forEachIndexed { index, choice ->
                DropdownMenuItem(text = { Text(choice) }, onClick = { selectedIndex = index; field.selectedIndex = index; expanded = false; onNodeUpdated() })
            }
        }
    }
}

@Composable
fun ConfirmationCallbackField(field: ConfirmationCallback, onNext: () -> Unit) {
    Row(modifier = Modifier.padding(4.dp).fillMaxWidth(), horizontalArrangement = Arrangement.Center) {
        field.options.forEachIndexed { index, label ->
            Button(modifier = Modifier.padding(horizontal = 4.dp), onClick = { field.selectedIndex = index; onNext() }) { Text(label) }
        }
    }
}

@Composable
fun BooleanCallbackField(field: BooleanAttributeInputCallback, onNodeUpdated: () -> Unit) {
    var checked by remember(field) { mutableStateOf(field.value) }
    Row(modifier = Modifier.padding(8.dp).fillMaxWidth(), verticalAlignment = Alignment.CenterVertically) {
        Switch(checked = checked, onCheckedChange = { checked = it; field.value = it; onNodeUpdated() })
        Text(text = field.prompt, modifier = Modifier.padding(start = 8.dp))
    }
}

@Composable
fun NumberCallbackField(field: NumberAttributeInputCallback, onNodeUpdated: () -> Unit) {
    var text by remember(field) { mutableStateOf(field.value.toString()) }
    Row(modifier = Modifier.padding(4.dp).fillMaxWidth()) {
        Spacer(Modifier.weight(1f))
        OutlinedTextField(modifier = Modifier.wrapContentWidth(Alignment.CenterHorizontally), value = text,
            onValueChange = { text = it; it.toDoubleOrNull()?.let { num -> field.value = num; onNodeUpdated() } },
            label = { Text(field.prompt) }, keyboardOptions = KeyboardOptions(keyboardType = KeyboardType.Number))
        Spacer(Modifier.weight(1f))
    }
}

