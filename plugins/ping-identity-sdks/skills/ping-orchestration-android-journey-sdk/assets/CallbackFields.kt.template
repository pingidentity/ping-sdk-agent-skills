@OptIn(ExperimentalMaterial3Api::class)
@Composable
fun KbaCreateCallbackField(field: KbaCreateCallback, onNodeUpdated: () -> Unit) {
    var expanded by remember { mutableStateOf(false) }
    var selectedQuestion by remember(field) { mutableStateOf("") }
    var answer by remember(field) { mutableStateOf("") }
    Column(modifier = Modifier.padding(4.dp).fillMaxWidth()) {
        ExposedDropdownMenuBox(expanded = expanded, onExpandedChange = { expanded = !expanded }) {
            OutlinedTextField(value = selectedQuestion, onValueChange = {}, readOnly = true, label = { Text("Security Question") },
                trailingIcon = { ExposedDropdownMenuDefaults.TrailingIcon(expanded) },
                modifier = Modifier.fillMaxWidth().menuAnchor(MenuAnchorType.PrimaryNotEditable, true))
            ExposedDropdownMenu(expanded = expanded, onDismissRequest = { expanded = false }) {
                field.predefinedQuestions.forEach { q -> DropdownMenuItem(text = { Text(q) }, onClick = { selectedQuestion = q; field.selectedQuestion = q; expanded = false; onNodeUpdated() }) }
            }
        }
        Spacer(Modifier.height(8.dp))
        OutlinedTextField(value = answer, onValueChange = { answer = it; field.answer = it; onNodeUpdated() }, label = { Text("Answer") }, modifier = Modifier.fillMaxWidth())
    }
}

@Composable
fun TermsCallbackField(field: TermsAndConditionsCallback, onNodeUpdated: () -> Unit) {
    var accepted by remember(field) { mutableStateOf(false) }
    Column(modifier = Modifier.padding(8.dp).fillMaxWidth()) {
        Text(text = field.terms, style = MaterialTheme.typography.bodySmall)
        Spacer(Modifier.height(8.dp))
        Row(verticalAlignment = Alignment.CenterVertically) {
            Checkbox(checked = accepted, onCheckedChange = { accepted = it; field.accept = it; onNodeUpdated() })
            Text("I accept the terms and conditions (v${field.version})")
        }
    }
}

@Composable
fun ConsentCallbackField(field: ConsentMappingCallback, onNodeUpdated: () -> Unit) {
    var accepted by remember(field) { mutableStateOf(false) }
    Row(modifier = Modifier.padding(8.dp).fillMaxWidth(), verticalAlignment = Alignment.CenterVertically) {
        Checkbox(checked = accepted, onCheckedChange = { accepted = it; field.accept = it; onNodeUpdated() })
        Text(field.displayName)
    }
}

@Composable
fun PollingWaitCallbackField(field: PollingWaitCallback, onNext: () -> Unit) {
    val scope = rememberCoroutineScope()
    val currentOnNext by rememberUpdatedState(onNext)
    LaunchedEffect(field) { scope.launch { delay(field.waitTime.toLong()); currentOnNext() } }
    Column(modifier = Modifier.fillMaxWidth().padding(16.dp), horizontalAlignment = Alignment.CenterHorizontally) {
        CircularProgressIndicator(modifier = Modifier.size(48.dp))
        Spacer(Modifier.height(8.dp))
        Text(text = field.message, style = MaterialTheme.typography.bodyMedium)
    }
}

@Composable
fun SuspendedTextOutputCallbackField(field: SuspendedTextOutputCallback) {
    Column(modifier = Modifier.fillMaxWidth().padding(16.dp), horizontalAlignment = Alignment.CenterHorizontally) {
        Text(text = field.message, style = MaterialTheme.typography.bodyLarge)
        Spacer(Modifier.height(8.dp))
        Text(text = "Check your email to continue", style = MaterialTheme.typography.bodySmall, color = MaterialTheme.colorScheme.onSurfaceVariant)
    }
}

