import SwiftUI
import PingDavinci

/// Auto-collects PingOne Protect risk signals for a ProtectCollector.
/// Shows a loading indicator while signals are being collected,
/// then automatically advances the flow.
struct PingProtectView: View {
    let collector: ProtectCollector
    let onNext: (Bool) -> Void

    var body: some View {
        ProgressView("Collecting security signals...")
            .task {
                do {
                    try await collector.collect()
                } catch {
                    print("PingProtect collect error: \(error)")
                }
                onNext(false)
            }
    }
}
