/*
 * DaVinci View — root SwiftUI view that renders the current DaVinci node.
 *
 * INSTRUCTIONS:
 *   1. Place in YourApp/Views/DavinciView.swift
 *   2. Pass your DavinciViewModel instance as a parameter.
 */

import SwiftUI
import PingDavinci
import PingOrchestrate

struct DavinciView: View {
    @ObservedObject var viewModel: DavinciViewModel

    var body: some View {
        ZStack {
            if viewModel.isLoading {
                ProgressView("Loading...")
            }

            switch viewModel.state.node {
            case let node as ContinueNode:
                ConnectorView(
                    node: node,
                    onNext: { isSubmit in
                        Task {
                            await viewModel.next(node)
                        }
                    },
                    onStart: {
                        Task {
                            await viewModel.start()
                        }
                    }
                )

            case is SuccessNode:
                VStack {
                    Image(systemName: "checkmark.circle.fill")
                        .font(.system(size: 60))
                        .foregroundColor(.green)
                    Text("Authentication Successful!")
                        .font(.title2)
                        .padding(.top, 8)
                }

            case let node as ErrorNode:
                ErrorNodeView(
                    errorNode: node,
                    viewModel: viewModel
                )

            case let node as FailureNode:
                VStack(spacing: 12) {
                    Image(systemName: "exclamationmark.triangle.fill")
                        .font(.system(size: 60))
                        .foregroundColor(.red)
                    Text("Authentication Failed")
                        .font(.title2)
                    Text(node.cause.localizedDescription)
                        .font(.body)
                        .foregroundColor(.secondary)
                        .multilineTextAlignment(.center)
                    Button("Try Again") {
                        Task { await viewModel.start() }
                    }
                    .padding(.top, 8)
                }
                .padding()

            default:
                ProgressView()
            }
        }
    }
}

// ── Connector View ──────────────────────────────────────────────────────────

/// Wraps a ContinueNodeView with validation support.
struct ConnectorView: View {
    let node: ContinueNode
    let onNext: (Bool) -> Void
    let onStart: () -> Void
    @StateObject private var validationVM = ValidationViewModel()

    var body: some View {
        ContinueNodeView(
            node: node,
            onNext: onNext,
            onStart: onStart
        )
        .environmentObject(validationVM)
    }
}

// ── Error Node View ─────────────────────────────────────────────────────────

struct ErrorNodeView: View {
    let errorNode: ErrorNode
    @ObservedObject var viewModel: DavinciViewModel
    @State private var showAlert = true

    var body: some View {
        ZStack {
            // Re-render previous ContinueNode if available
            if let previousNode = errorNode.continueNode() {
                ConnectorView(
                    node: previousNode,
                    onNext: { isSubmit in
                        Task { await viewModel.next(previousNode) }
                    },
                    onStart: {
                        Task { await viewModel.start() }
                    }
                )
            }
        }
        .alert("Error", isPresented: $showAlert) {
            Button("OK") {
                if errorNode.continueNode() == nil {
                    Task { await viewModel.start() }
                }
            }
        } message: {
            Text(errorNode.message)
        }
    }
}
