import SwiftUI
import PingDavinci

/// Renders device authentication options for a DeviceAuthenticationCollector.
struct DeviceAuthenticationView: View {
    let collector: DeviceAuthenticationCollector
    let onNext: (Bool) -> Void

    var body: some View {
        VStack(alignment: .leading, spacing: 8) {
            Text(collector.label)
                .font(.headline)

            ForEach(collector.devices, id: \.type) { device in
                Button(action: {
                    collector.value = device
                    onNext(true)
                }) {
                    Text(device.type)
                        .frame(maxWidth: .infinity)
                }
                .buttonStyle(.bordered)
            }
        }
    }
}
