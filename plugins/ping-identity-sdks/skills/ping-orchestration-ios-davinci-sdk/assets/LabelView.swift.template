import SwiftUI
import PingDavinci

/// Renders a static text label for a LabelCollector.
struct LabelView: View {
    let collector: LabelCollector

    var body: some View {
        Text(collector.content)
            .font(.body)
            .padding(.vertical, 2)
    }
}
