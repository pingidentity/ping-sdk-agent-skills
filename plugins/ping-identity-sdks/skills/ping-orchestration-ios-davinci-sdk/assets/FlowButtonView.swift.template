import SwiftUI
import PingDavinci

/// Renders a flow navigation button or link for a FlowCollector.
/// Renders as a bordered button for FLOW_LINK, or a prominent button for FLOW_BUTTON.
struct FlowButtonView: View {
    let collector: FlowCollector
    let onNext: (Bool) -> Void

    var body: some View {
        Button(action: {
            collector.value = collector.key
            onNext(false)  // false = skip validation for flow navigation
        }) {
            Text(collector.label)
                .frame(maxWidth: .infinity)
        }
        .buttonStyle(collector.type == "FLOW_LINK" ? .bordered : .borderedProminent)
        .padding(.top, 4)
    }
}
