/*
 * User Info View — displays user info from the OIDC userinfo endpoint.
 *
 * INSTRUCTIONS:
 *   1. Place in YourApp/Views/UserInfoView.swift
 */

import SwiftUI

struct UserInfoView: View {
    let menuItem: MenuItem
    @StateObject private var viewModel = UserInfoViewModel()

    var body: some View {
        ScrollView {
            VStack(spacing: 16) {
                if viewModel.isLoading {
                    ProgressView("Fetching user info...")
                } else if let error = viewModel.error {
                    ErrorMessageView(message: error)
                } else if let userInfo = viewModel.userInfo {
                    ForEach(userInfo.sorted(by: { $0.key < $1.key }), id: \.key) { key, value in
                        HStack {
                            Text(key)
                                .font(.subheadline)
                                .fontWeight(.medium)
                                .foregroundStyle(.secondary)
                            Spacer()
                            Text("\(value)")
                                .font(.subheadline)
                                .multilineTextAlignment(.trailing)
                        }
                        .padding(.horizontal)
                        Divider()
                    }
                } else {
                    Text("No user info available. Please authenticate first.")
                        .foregroundStyle(.secondary)
                }
            }
            .padding()
        }
        .navigationTitle(menuItem.rawValue)
        .task {
            await viewModel.fetchUserInfo()
        }
    }
}
