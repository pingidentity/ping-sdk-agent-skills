/*
 * Device Signing Verifier Callback View — signs a challenge with the device key.
 * Requires: PingBinding module.
 *
 * INSTRUCTIONS:
 *   1. Place in YourApp/Callbacks/DeviceSigningVerifierCallbackView.swift
 *   2. Add PingBinding as an SPM dependency.
 */

import SwiftUI
import PingBinding

struct DeviceSigningVerifierCallbackView: View {
    let callback: DeviceSigningVerifierCallback
    let onNext: () -> Void

    @State private var status: String = "Verifying device..."
    @State private var error: String?

    var body: some View {
        VStack(spacing: 12) {
            if let error = error {
                ErrorMessageView(message: "Device signing failed: \(error)")
            } else {
                ProgressView(status)
            }
        }
        .padding()
        .onAppear {
            Task {
                let result = await callback.sign()
                switch result {
                case .success:
                    onNext()
                case .failure(let signingError):
                    error = signingError.localizedDescription
                }
            }
        }
    }
}
