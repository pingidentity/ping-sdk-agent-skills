/*
 * PingOne Protect Evaluation Callback View — collects and submits threat signals.
 * Requires: PingProtect module.
 *
 * INSTRUCTIONS:
 *   1. Place in YourApp/Callbacks/PingOneProtectEvaluationCallbackView.swift
 *   2. Add PingProtect as an SPM dependency.
 */

import SwiftUI
import PingProtect

struct PingOneProtectEvaluationCallbackView: View {
    let callback: PingOneProtectEvaluationCallback
    let onNext: () -> Void

    @State private var error: String?

    var body: some View {
        VStack(spacing: 12) {
            if let error = error {
                ErrorMessageView(message: "Protect evaluation failed: \(error)")
            } else {
                ProgressView("Evaluating threat signals...")
            }
        }
        .padding()
        .onAppear {
            Task {
                do {
                    try await callback.getData()
                    onNext()
                } catch {
                    self.error = error.localizedDescription
                }
            }
        }
    }
}
