/*
 * KBA Create Callback View — security question and answer.
 *
 * INSTRUCTIONS:
 *   1. Place in YourApp/Callbacks/KbaCreateCallbackView.swift
 */

import SwiftUI
import PingJourney

struct KbaCreateCallbackView: View {
    let callback: KbaCreateCallback
    let onNodeUpdated: () -> Void

    @State private var selectedQuestion: String = ""
    @State private var answer: String = ""
    @State private var customQuestion: String = ""

    var body: some View {
        VStack(alignment: .leading, spacing: 8) {
            Text(callback.prompt)
                .font(.subheadline)
                .fontWeight(.medium)

            // Question selection
            Picker("Security Question", selection: $selectedQuestion) {
                ForEach(callback.predefinedQuestions, id: \.self) { question in
                    Text(question).tag(question)
                }
                if callback.allowUserDefinedQuestions {
                    Text("Custom Question").tag("__custom__")
                }
            }
            .pickerStyle(.menu)
            .onChange(of: selectedQuestion) { newValue in
                if newValue == "__custom__" {
                    callback.selectedQuestion = customQuestion
                } else {
                    callback.selectedQuestion = newValue
                }
            }
            .onAppear {
                if let first = callback.predefinedQuestions.first {
                    selectedQuestion = first
                    callback.selectedQuestion = first
                }
            }

            // Custom question input
            if selectedQuestion == "__custom__" && callback.allowUserDefinedQuestions {
                TextField("Enter your question", text: $customQuestion)
                    .textFieldStyle(.roundedBorder)
                    .onChange(of: customQuestion) { newValue in
                        callback.selectedQuestion = newValue
                    }
            }

            // Answer input
            TextField("Answer", text: $answer)
                .textFieldStyle(.roundedBorder)
                .onChange(of: answer) { newValue in
                    callback.selectedAnswer = newValue
                }
        }
        .padding(.vertical, 4)
    }
}
