/*
 * User Info ViewModel — fetches user info from the OIDC userinfo endpoint.
 *
 * INSTRUCTIONS:
 *   1. Place in YourApp/ViewModels/UserInfoViewModel.swift
 */

import SwiftUI
import PingJourney
import PingOidc

@MainActor
class UserInfoViewModel: ObservableObject {
    @Published var userInfo: [String: Any]?
    @Published var isLoading: Bool = false
    @Published var error: String?

    func fetchUserInfo() async {
        isLoading = true
        error = nil
        do {
            let user = journey.user()
            userInfo = try await user?.userinfo()
        } catch {
            self.error = error.localizedDescription
        }
        isLoading = false
    }
}
