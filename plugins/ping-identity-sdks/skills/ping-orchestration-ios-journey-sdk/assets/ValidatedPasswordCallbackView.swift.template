/*
 * Validated Password Callback View — password input with policy validation.
 *
 * INSTRUCTIONS:
 *   1. Place in YourApp/Callbacks/ValidatedPasswordCallbackView.swift
 */

import SwiftUI
import PingJourney

struct ValidatedPasswordCallbackView: View {
    let callback: ValidatedPasswordCallback
    let onNodeUpdated: () -> Void

    @State private var password: String = ""
    @State private var isVisible: Bool = false

    var body: some View {
        VStack(alignment: .leading, spacing: 4) {
            HStack {
                if isVisible {
                    TextField(callback.prompt, text: $password)
                        .textFieldStyle(.roundedBorder)
                        .autocapitalization(.none)
                        .disableAutocorrection(true)
                } else {
                    SecureField(callback.prompt, text: $password)
                        .textFieldStyle(.roundedBorder)
                }

                Button {
                    isVisible.toggle()
                } label: {
                    Image(systemName: isVisible ? "eye.slash" : "eye")
                        .foregroundStyle(.secondary)
                }
            }
            .onChange(of: password) { newValue in
                callback.password = newValue
            }

            // Display failed policy messages
            if !callback.failedPolicies.isEmpty {
                ForEach(callback.failedPolicies, id: \.self) { policy in
                    Text(policy)
                        .font(.caption)
                        .foregroundStyle(.red)
                }
            }
        }
        .padding(.vertical, 4)
    }
}
