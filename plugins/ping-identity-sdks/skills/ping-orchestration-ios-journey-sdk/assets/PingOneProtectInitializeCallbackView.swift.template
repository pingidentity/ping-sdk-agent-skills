/*
 * PingOne Protect Initialize Callback View — initializes threat signal collection.
 * Requires: PingProtect module.
 *
 * INSTRUCTIONS:
 *   1. Place in YourApp/Callbacks/PingOneProtectInitializeCallbackView.swift
 *   2. Add PingProtect as an SPM dependency.
 */

import SwiftUI
import PingProtect

struct PingOneProtectInitializeCallbackView: View {
    let callback: PingOneProtectInitializeCallback
    let onNext: () -> Void

    @State private var error: String?

    var body: some View {
        VStack(spacing: 12) {
            if let error = error {
                ErrorMessageView(message: "Protect initialization failed: \(error)")
            } else {
                ProgressView("Initializing PingOne Protect...")
            }
        }
        .padding()
        .onAppear {
            Task {
                do {
                    try await callback.start()
                    onNext()
                } catch {
                    self.error = error.localizedDescription
                }
            }
        }
    }
}
