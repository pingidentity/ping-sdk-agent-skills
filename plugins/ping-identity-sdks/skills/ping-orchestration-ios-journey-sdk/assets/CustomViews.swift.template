// MARK: - LoadingOverlay

/// Full-screen loading overlay with a progress indicator.
struct LoadingOverlay: View {
    let message: String

    var body: some View {
        ZStack {
            Color.black.opacity(0.3)
                .ignoresSafeArea()
            VStack(spacing: 16) {
                ProgressView()
                    .scaleEffect(1.2)
                Text(message)
                    .font(.subheadline)
                    .foregroundStyle(.secondary)
            }
            .padding(24)
            .background(.ultraThinMaterial)
            .clipShape(RoundedRectangle(cornerRadius: 12))
        }
    }
}

// MARK: - CopyableText

/// Text that can be tapped to copy to clipboard.
struct CopyableText: View {
    let label: String
    let value: String
    @State private var copied = false

    var body: some View {
        VStack(alignment: .leading, spacing: 4) {
            Text(label)
                .font(.caption)
                .foregroundStyle(.secondary)
            Text(value)
                .font(.system(.body, design: .monospaced))
                .lineLimit(3)
                .truncationMode(.middle)
        }
        .frame(maxWidth: .infinity, alignment: .leading)
        .padding(12)
        .background(Color.groupedBackground)
        .clipShape(RoundedRectangle(cornerRadius: 8))
        .onTapGesture {
            UIPasteboard.general.string = value
            copied = true
            DispatchQueue.main.asyncAfter(deadline: .now() + 2) {
                copied = false
            }
        }
        .overlay(alignment: .topTrailing) {
            if copied {
                Text("Copied!")
                    .font(.caption2)
                    .padding(4)
                    .background(.green.opacity(0.2))
                    .clipShape(Capsule())
                    .padding(4)
            }
        }
    }
}

// MARK: - MenuSection / MenuItem

/// Navigation menu item for ContentView.
enum MenuItem: String, Hashable, CaseIterable {
    case journey = "Journey"
    case token = "Access Token"
    case user = "User Info"
    case logout = "Logout"
}

/// Section of navigation menu items.
struct MenuSection: View {
    let items: [MenuItem]
    let icon: (MenuItem) -> String

    var body: some View {
        ForEach(items, id: \.self) { item in
            NavigationLink(value: item) {
                Label(item.rawValue, systemImage: icon(item))
            }
        }
    }
}
