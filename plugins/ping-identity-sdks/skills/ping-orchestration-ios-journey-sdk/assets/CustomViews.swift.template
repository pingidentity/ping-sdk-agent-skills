import SwiftUI

// MARK: - NextButton

/// Reusable styled button for form submission.
struct NextButton: View {
    let text: String
    let action: () -> Void

    var body: some View {
        Button(action: action) {
            Text(text)
                .fontWeight(.semibold)
                .frame(maxWidth: .infinity)
                .padding(.vertical, 12)
        }
        .buttonStyle(.borderedProminent)
        .padding(.horizontal)
    }
}

// MARK: - HeaderView

/// Displays a Journey node header.
struct HeaderView: View {
    let text: String

    var body: some View {
        Text(text)
            .font(.title2)
            .fontWeight(.bold)
            .multilineTextAlignment(.center)
            .padding(.bottom, 4)
    }
}

// MARK: - DescriptionView

/// Displays a Journey node description.
struct DescriptionView: View {
    let text: String

    var body: some View {
        Text(text)
            .font(.body)
            .foregroundStyle(.secondary)
            .multilineTextAlignment(.center)
            .padding(.bottom, 8)
    }
}

// MARK: - SectionHeader

/// Section header for grouped content.
struct SectionHeader: View {
    let title: String

    var body: some View {
        Text(title)
            .font(.headline)
            .fontWeight(.semibold)
            .frame(maxWidth: .infinity, alignment: .leading)
            .padding(.top, 12)
