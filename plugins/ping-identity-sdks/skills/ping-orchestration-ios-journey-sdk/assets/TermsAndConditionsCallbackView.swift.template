/*
 * Terms and Conditions Callback View — terms acceptance toggle.
 *
 * INSTRUCTIONS:
 *   1. Place in YourApp/Callbacks/TermsAndConditionsCallbackView.swift
 */

import SwiftUI
import PingJourney

struct TermsAndConditionsCallbackView: View {
    let callback: TermsAndConditionsCallback
    let onNodeUpdated: () -> Void

    @State private var accepted: Bool = false
    @State private var showTerms: Bool = false

    var body: some View {
        VStack(alignment: .leading, spacing: 8) {
            HStack {
                Toggle("I accept the Terms and Conditions", isOn: $accepted)
                    .onChange(of: accepted) { newValue in
                        callback.accepted = newValue
                    }
            }

            Button("View Terms (v\(callback.version))") {
                showTerms.toggle()
            }
            .font(.caption)

            if showTerms {
                ScrollView {
                    Text(callback.terms)
                        .font(.caption)
                        .foregroundStyle(.secondary)
                        .padding(8)
                }
                .frame(maxHeight: 200)
                .background(Color.groupedBackground)
                .clipShape(RoundedRectangle(cornerRadius: 8))
            }
        }
        .padding(.vertical, 4)
    }
}
