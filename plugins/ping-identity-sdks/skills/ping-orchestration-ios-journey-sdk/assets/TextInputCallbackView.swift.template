/*
 * Text Input Callback View — generic text input (OTP, nickname, etc.).
 *
 * INSTRUCTIONS:
 *   1. Place in YourApp/Callbacks/TextInputCallbackView.swift
 */

import SwiftUI
import PingJourney

struct TextInputCallbackView: View {
    let callback: TextInputCallback
    let onNodeUpdated: () -> Void

    @State private var text: String = ""

    var body: some View {
        VStack(alignment: .leading, spacing: 4) {
            TextField(callback.prompt, text: $text)
                .textFieldStyle(.roundedBorder)
                .autocapitalization(.none)
                .disableAutocorrection(true)
                .onChange(of: text) { newValue in
                    callback.text = newValue
                }
                .onAppear {
                    text = callback.defaultText ?? ""
                }
        }
        .padding(.vertical, 4)
    }
}
