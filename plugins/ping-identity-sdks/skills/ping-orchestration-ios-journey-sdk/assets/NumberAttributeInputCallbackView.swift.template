/*
 * Number Attribute Input Callback View — numeric input.
 *
 * INSTRUCTIONS:
 *   1. Place in YourApp/Callbacks/NumberAttributeInputCallbackView.swift
 */

import SwiftUI
import PingJourney

struct NumberAttributeInputCallbackView: View {
    let callback: NumberAttributeInputCallback
    let onNodeUpdated: () -> Void

    @State private var text: String = ""

    var body: some View {
        VStack(alignment: .leading, spacing: 4) {
            TextField(callback.prompt, text: $text)
                .textFieldStyle(.roundedBorder)
                .keyboardType(.decimalPad)
                .onChange(of: text) { newValue in
                    if let value = Double(newValue) {
                        callback.value = value
                    }
                }
                .onAppear {
                    if let value = callback.value {
                        text = String(value)
                    }
                }
        }
        .padding(.vertical, 4)
    }
}
