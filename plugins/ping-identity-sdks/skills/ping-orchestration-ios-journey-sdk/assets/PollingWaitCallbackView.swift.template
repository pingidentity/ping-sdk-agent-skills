/*
 * Polling Wait Callback View — auto-advancing wait step.
 *
 * INSTRUCTIONS:
 *   1. Place in YourApp/Callbacks/PollingWaitCallbackView.swift
 */

import SwiftUI
import PingJourney

struct PollingWaitCallbackView: View {
    let callback: PollingWaitCallback
    let onNext: () -> Void

    var body: some View {
        VStack(spacing: 12) {
            ProgressView()
                .scaleEffect(1.2)

            Text(callback.message)
                .font(.subheadline)
                .foregroundStyle(.secondary)
                .multilineTextAlignment(.center)
        }
        .padding()
        .onAppear {
            let waitTime = Double(callback.waitTime) / 1000.0
            DispatchQueue.main.asyncAfter(deadline: .now() + waitTime) {
                onNext()
            }
        }
    }
}
