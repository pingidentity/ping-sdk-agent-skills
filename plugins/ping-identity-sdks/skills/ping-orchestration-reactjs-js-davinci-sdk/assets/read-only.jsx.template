import React from 'react';

/**
 * Renders a read-only label for a ReadOnlyCollector.
 *
 * @param {object} props
 * @param {object} props.collector - The ReadOnlyCollector from DaVinci.
 */
export default function ReadOnly({ collector }) {
  return (
    <div className="collector-field read-only">
      <p>{collector.output?.label || ''}</p>
    </div>
  );
}
