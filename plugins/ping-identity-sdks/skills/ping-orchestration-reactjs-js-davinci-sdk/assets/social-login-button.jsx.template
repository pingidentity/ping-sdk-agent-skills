import React from 'react';

/**
 * Renders a social/external identity provider login button for an IdpCollector.
 *
 * @param {object} props
 * @param {object} props.collector - The IdpCollector from DaVinci.
 */
export default function SocialLoginButton({ collector }) {
  const label = collector.output?.label || 'Sign in with provider';
  const url = collector.output?.url;

  if (!url) {
    return null;
  }

  return (
    <div className="collector-field">
      <a
        href={url}
        className="btn btn-social"
        role="button"
      >
        {label}
      </a>
    </div>
  );
}
