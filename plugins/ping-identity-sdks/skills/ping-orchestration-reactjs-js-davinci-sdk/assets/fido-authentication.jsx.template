import React, { useEffect, useState } from 'react';
import { fido } from '@forgerock/davinci-client';

/**
 * Handles FIDO2 passkey / security-key authentication in a DaVinci flow.
 *
 * @param {object}   props
 * @param {object}   props.collector - The FidoAuthenticationCollector from DaVinci.
 * @param {object}   props.client    - The DaVinci client instance.
 * @param {Function} props.onNext    - Callback that submits the current node.
 */
export default function FidoAuthentication({ collector, client, onNext }) {
  const [error, setError] = useState(null);
  const fidoApi = fido();

  const performAuthentication = async () => {
    setError(null);
    const credentialOptions = collector.output.config.publicKeyCredentialRequestOptions;
    const result = await fidoApi.authenticate(credentialOptions);

    if ('error' in result) {
      setError(result.message || 'FIDO2 authentication failed');
      return;
    }

    const updater = client.update(collector);
    const updateError = updater(result);
    if (updateError && 'error' in updateError) {
      setError(updateError.error.message);
      return;
    }

    await onNext();
  };

  // Auto-trigger if trigger is not BUTTON.
  useEffect(() => {
    if (collector.output?.config?.trigger !== 'BUTTON') {
      performAuthentication();
    }
    // eslint-disable-next-line react-hooks/exhaustive-deps
  }, [collector]);

  return (
    <div className="collector-field">
      {error && (
        <p className="field-error" role="alert">
          {error}
        </p>
      )}
      <button
        type="button"
        className="btn btn-primary"
        onClick={performAuthentication}
      >
        {collector.output?.label || 'Authenticate with Passkey'}
      </button>
    </div>
  );
}
