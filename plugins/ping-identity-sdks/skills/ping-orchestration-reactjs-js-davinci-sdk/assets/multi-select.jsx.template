import React, { useState } from 'react';

/**
 * Renders a checkbox group for a MultiSelectCollector.
 *
 * @param {object} props
 * @param {object} props.collector - The MultiSelectCollector from DaVinci.
 * @param {object} props.client    - The DaVinci client instance.
 */
export default function MultiSelect({ collector, client }) {
  const [selected, setSelected] = useState(collector.input?.value || []);
  const options = collector.output?.options || [];

  const handleToggle = (optionValue) => {
    const updated = selected.includes(optionValue)
      ? selected.filter((v) => v !== optionValue)
      : [...selected, optionValue];

    setSelected(updated);

    const updater = client.update(collector);
    updater(updated);
  };

  return (
    <fieldset className="collector-field">
      <legend>{collector.output?.label || 'Select options'}</legend>
      {options.map((opt) => (
        <label key={opt.value} className="checkbox-label">
          <input
            type="checkbox"
            checked={selected.includes(opt.value)}
            onChange={() => handleToggle(opt.value)}
          />
          {opt.label}
        </label>
      ))}
      {collector.error && (
        <p className="field-error" role="alert">
          {collector.error}
        </p>
      )}
    </fieldset>
  );
}
