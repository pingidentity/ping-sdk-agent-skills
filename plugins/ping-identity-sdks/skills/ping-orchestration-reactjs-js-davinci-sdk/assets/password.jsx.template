import React, { useState } from 'react';

/**
 * Renders a password input for a PasswordCollector.
 *
 * @param {object} props
 * @param {object} props.collector - The PasswordCollector from DaVinci.
 * @param {object} props.client    - The DaVinci client instance.
 */
export default function PasswordCollectorField({ collector, client }) {
  const [value, setValue] = useState('');
  const [visible, setVisible] = useState(false);
  const [validationError, setValidationError] = useState('');

  const handleChange = (e) => {
    const newValue = e.target.value;
    setValue(newValue);

    const updater = client.update(collector);
    updater(newValue);

    // Run client-side validation if the collector supports it.
    if (collector.category === 'ValidatedSingleValueCollector') {
      const validator = client.validate(collector);
      const errors = validator(newValue);
      setValidationError(errors?.length ? errors[0] : '');
    }
  };

  return (
    <div className="collector-field">
      <label htmlFor={collector.id}>
        {collector.output?.label || 'Password'}
      </label>
      <div className="password-wrapper">
        <input
          id={collector.id}
          type={visible ? 'text' : 'password'}
          value={value}
          onChange={handleChange}
          autoComplete="current-password"
          aria-describedby={validationError ? `${collector.id}-error` : undefined}
        />
        <button
          type="button"
          className="toggle-visibility"
          onClick={() => setVisible((v) => !v)}
          aria-label={visible ? 'Hide password' : 'Show password'}
        >
          {visible ? '🙈' : '👁️'}
        </button>
      </div>
      {(validationError || collector.error) && (
        <p id={`${collector.id}-error`} className="field-error" role="alert">
          {validationError || collector.error}
        </p>
      )}
    </div>
  );
}
