import { useCallback, useEffect, useRef, useState } from 'react';
import { davinci } from '@forgerock/davinci-client';
import { DAVINCI_CONFIG } from './constants';

/**
 * Custom React hook that manages the DaVinci authentication flow.
 *
 * @returns {{
 *   node: object | null,
 *   error: object | null,
 *   loading: boolean,
 *   collectors: Array,
 *   clientRef: React.MutableRefObject,
 *   startFlow: () => Promise<void>,
 *   next: () => Promise<void>,
 *   navigateFlow: (action: string) => Promise<void>,
 * }}
 */
export function useDavinci() {
  const [node, setNode] = useState(null);
  const [error, setError] = useState(null);
  const [loading, setLoading] = useState(true);
  const [collectors, setCollectors] = useState([]);
  const clientRef = useRef(null);

  /**
   * Process the current client state after any flow transition.
   */
  const processNode = useCallback((client) => {
    const status = client.getClient().status;

    if (status === 'continue') {
      setNode({ status, collectors: client.getCollectors() });
      setCollectors(client.getCollectors());
      setError(null);
    } else if (status === 'success') {
      setNode({ status, client: client.getClient() });
      setCollectors([]);
      setError(null);
    } else if (status === 'error') {
      const err = client.getError();
      setError(err);

      // DaVinci error nodes may still carry collectors for re-render.
      const errorCollectors = client.getCollectors();
      if (errorCollectors && errorCollectors.length > 0) {
        setNode({ status: 'continue', collectors: errorCollectors });
        setCollectors(errorCollectors);
      }
    }
  }, []);

  /**
   * Initialise the DaVinci client and start the flow.
   */
  const startFlow = useCallback(async () => {
    setLoading(true);
    setError(null);

    try {
      const client = await davinci({ config: DAVINCI_CONFIG });
      clientRef.current = client;
      processNode(client);
    } catch (err) {
      setError({ message: err.message || 'Failed to start DaVinci flow' });
    } finally {
      setLoading(false);
    }
  }, [processNode]);

  /**
   * Submit the current node (used after collecting user input).
   */
  const next = useCallback(async () => {
    if (!clientRef.current) return;
    setLoading(true);
    setError(null);

    try {
      const updated = await clientRef.current.next();
      clientRef.current = updated;
      processNode(updated);
    } catch (err) {
      setError({ message: err.message || 'Failed to advance flow' });
    } finally {
      setLoading(false);
    }
  }, [processNode]);

  /**
   * Navigate to a different flow branch (e.g. "Forgot password").
   *
   * @param {string} action - The flow action key from a FlowCollector.
   */
  const navigateFlow = useCallback(
    async (action) => {
      if (!clientRef.current) return;
      setLoading(true);
      setError(null);

      try {
        const updated = await clientRef.current.flow({ action });
        clientRef.current = updated;
        processNode(updated);
      } catch (err) {
        setError({ message: err.message || 'Failed to navigate flow' });
      } finally {
        setLoading(false);
      }
    },
    [processNode],
  );

  // Start the flow on mount.
  useEffect(() => {
    startFlow();
  }, [startFlow]);

  return {
    node,
    error,
    loading,
    collectors,
    clientRef,
    startFlow,
    next,
    navigateFlow,
  };
}
