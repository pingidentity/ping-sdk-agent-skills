package com.example.myapp.auth.collector

import androidx.compose.foundation.layout.fillMaxWidth
import androidx.compose.foundation.layout.padding
import androidx.compose.material3.Button
import androidx.compose.material3.Text
import androidx.compose.runtime.Composable
import androidx.compose.ui.Modifier
import androidx.compose.ui.unit.dp
import com.pingidentity.davinci.collector.SubmitCollector
import com.pingidentity.orchestrate.ContinueNode

/**
 * Renders a submit button for a [SubmitCollector].
 * Clicking advances the DaVinci flow to the next node.
 */
@Composable
fun SubmitButton(collector: SubmitCollector, onNext: (ContinueNode) -> Unit) {
    Button(
        onClick = {
            collector.value = collector.label
            onNext(collector.continueNode)
        },
        modifier = Modifier
            .fillMaxWidth()
            .padding(top = 8.dp),
    ) {
        Text(collector.label)
    }
}
