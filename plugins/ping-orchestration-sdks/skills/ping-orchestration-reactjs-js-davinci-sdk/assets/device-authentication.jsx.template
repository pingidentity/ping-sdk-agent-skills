import React, { useState } from 'react';

/**
 * Renders a device selection list for a DeviceAuthenticationCollector.
 *
 * @param {object}   props
 * @param {object}   props.collector - The DeviceAuthenticationCollector from DaVinci.
 * @param {object}   props.client    - The DaVinci client instance.
 * @param {Function} props.onNext    - Callback that submits the current node.
 */
export default function DeviceAuthentication({ collector, client, onNext }) {
  const [selected, setSelected] = useState('');
  const devices = collector.output?.options || [];

  const handleSelect = (device) => {
    setSelected(device.value);

    const updater = client.update(collector);
    updater(device.value);
  };

  return (
    <div className="collector-field">
      <p className="field-label">
        {collector.output?.label || 'Authenticate with a Device'}
      </p>
      <ul className="device-list">
        {devices.map((device) => (
          <li key={device.value}>
            <button
              type="button"
              className={`device-option ${selected === device.value ? 'selected' : ''}`}
              onClick={() => handleSelect(device)}
            >
              {device.label}
            </button>
          </li>
        ))}
      </ul>
      {selected && (
        <button
          type="button"
          className="btn btn-primary"
          onClick={onNext}
        >
          Authenticate
        </button>
      )}
      {collector.error && (
        <p className="field-error" role="alert">
          {collector.error}
        </p>
      )}
    </div>
  );
}
