import React from 'react';

/**
 * Renders a flow navigation button or link for a FlowCollector.
 *
 * @param {object}   props
 * @param {object}   props.collector - The FlowCollector from DaVinci.
 * @param {Function} props.onFlow    - Callback that navigates to a flow branch.
 */
export default function FlowButton({ collector, onFlow }) {
  const handleClick = (e) => {
    e.preventDefault();
    onFlow(collector.output.key);
  };

  return (
    <div className="collector-field">
      <button
        type="button"
        className="btn btn-secondary"
        onClick={handleClick}
      >
        {collector.output?.label || 'Continue'}
      </button>
    </div>
  );
}
