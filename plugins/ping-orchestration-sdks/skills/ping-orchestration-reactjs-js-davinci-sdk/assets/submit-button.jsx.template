import React from 'react';

/**
 * Renders a submit button for a SubmitCollector.
 *
 * @param {object}   props
 * @param {object}   props.collector - The SubmitCollector from DaVinci.
 * @param {Function} props.onNext    - Callback that submits the current node.
 */
export default function SubmitButton({ collector, onNext }) {
  return (
    <div className="collector-field">
      <button
        type="submit"
        className="btn btn-primary"
        onClick={(e) => {
          e.preventDefault();
          onNext();
        }}
      >
        {collector.output?.label || 'Submit'}
      </button>
    </div>
  );
}
