/*
 * ValidatedPasswordCallbackView.swift — Journey Standard tier
 *
 * Use `.password` (NOT `.value`). Display `.failedPolicies` on validation failure.
 */

import SwiftUI
import PingJourney

struct ValidatedPasswordCallbackView: View {
    let callback: ValidatedPasswordCallback
    let onRefresh: () -> Void

    @State private var text: String = ""

    private var hasErrors: Bool { !callback.failedPolicies.isEmpty }

    var body: some View {
        VStack(alignment: .leading, spacing: 8) {
            PingSecureField(
                placeholder: callback.prompt,
                text: $text
            )
            .onAppear { text = callback.password }
            .onChange(of: text) { _, newValue in
                callback.password = newValue
            }
            .onSubmit { onRefresh() }

            if hasErrors {
                ErrorMessageView(
                    message: callback.failedPolicies
                        .map { $0.failedDescription(for: callback.prompt) }
                        .joined(separator: "\n")
                )
            }
        }
    }
}
