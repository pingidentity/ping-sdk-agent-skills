/*
 * FidoAuthenticationCollectorView.swift — DaVinci Standard tier
 *
 * Self-advancing: `collector.authenticate(window:)`.
 */

import SwiftUI
import UIKit
import PingFido

struct FidoAuthenticationCollectorView: View {
    let collector: FidoAuthenticationCollector
    let onNext: () -> Void

    var body: some View {
        VStack(spacing: 12) {
            Text("FIDO Authentication")
                .font(.title2)
                .fontWeight(.semibold)

            Button {
                Task { await authenticate() }
            } label: {
                Text(collector.label.isEmpty ? "Sign in with passkey" : collector.label)
            }
            .buttonStyle(PingPrimaryButtonStyle())
            .padding(.horizontal)
        }
    }

    private func authenticate() async {
        guard let window = UIApplication.shared.connectedScenes
            .compactMap({ ($0 as? UIWindowScene)?.windows.first })
            .first
        else { return }

        let result = await collector.authenticate(window: window)
        switch result {
        case .success: onNext()
        case .failure(let error):
            print("FIDO authentication failed: \(error.localizedDescription)")
        }
    }
}
