/*
 * PasswordCollectorView.swift — DaVinci Basic tier
 */

import SwiftUI
import PingDavinci

struct PasswordCollectorView: View {
    let field: PasswordCollector
    let onRefresh: () -> Void

    @State private var text: String = ""
    @State private var isValid: Bool = true

    var body: some View {
        VStack(alignment: .leading, spacing: 8) {
            PingSecureField(
                placeholder: field.required ? "\(field.label)*" : field.label,
                text: $text
            )
            .onAppear { text = field.value }
            .onChange(of: text) { _, newValue in
                field.value = newValue
                isValid = field.validate().isEmpty
                onRefresh()
            }

            if !isValid {
                ErrorMessageView(message: field.validate().map { $0.errorMessage }.joined(separator: "\n"))
            }
        }
        .padding(.horizontal)
    }
}
