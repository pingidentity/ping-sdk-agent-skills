/*
 * PasswordCallbackView.swift — Journey Basic tier
 *
 * Use `.password` (write); `.prompt` (read).
 */

import SwiftUI
import PingJourney

struct PasswordCallbackView: View {
    let callback: PasswordCallback
    let onRefresh: () -> Void

    @State private var text: String = ""

    var body: some View {
        VStack(alignment: .leading, spacing: 8) {
            PingSecureField(
                placeholder: callback.prompt,
                text: $text
            )
            .onAppear { text = callback.password }
            .onChange(of: text) { _, newValue in
                callback.password = newValue
            }
            .onSubmit { onRefresh() }
        }
    }
}
