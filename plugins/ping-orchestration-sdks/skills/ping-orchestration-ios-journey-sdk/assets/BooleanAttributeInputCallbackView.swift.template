/*
 * Boolean Attribute Input Callback View — toggle for boolean attributes.
 *
 * INSTRUCTIONS:
 *   1. Place in YourApp/Callbacks/BooleanAttributeInputCallbackView.swift
 */

import SwiftUI
import PingJourney

struct BooleanAttributeInputCallbackView: View {
    let callback: BooleanAttributeInputCallback
    let onNodeUpdated: () -> Void

    @State private var isOn: Bool = false

    var body: some View {
        Toggle(callback.prompt, isOn: $isOn)
            .onChange(of: isOn) { newValue in
                callback.value = newValue
            }
            .onAppear {
                isOn = callback.value
            }
            .padding(.vertical, 4)
    }
}
