/*
 * Select IdP Callback View — social/external IdP selection.
 * Requires: PingExternalIdP module.
 *
 * INSTRUCTIONS:
 *   1. Place in YourApp/Callbacks/SelectIdpCallbackView.swift
 *   2. Add PingExternalIdP (and PingExternalIdPGoogle, PingExternalIdPApple, etc.)
 *      as SPM dependencies.
 */

import SwiftUI
import PingExternalIdP

struct SelectIdpCallbackView: View {
    let callback: SelectIdpCallback
    let onNext: () -> Void

    var body: some View {
        VStack(spacing: 12) {
            Text("Sign in with")
                .font(.subheadline)
                .fontWeight(.medium)

            ForEach(callback.providers, id: \.provider) { idp in
                Button {
                    callback.value = idp.provider
                    onNext()
                } label: {
                    HStack {
                        Image(systemName: iconName(for: idp.provider))
                        Text(idp.provider)
                            .fontWeight(.medium)
                    }
                    .frame(maxWidth: .infinity)
                    .padding(.vertical, 10)
                }
                .buttonStyle(.bordered)
            }

            // Local authentication option
            Button {
                callback.value = "localAuthentication"
                onNext()
            } label: {
                Text("Use username and password")
                    .font(.subheadline)
                    .foregroundStyle(.secondary)
            }
        }
        .padding(.vertical, 8)
    }

    private func iconName(for provider: String) -> String {
        switch provider.lowercased() {
        case let p where p.contains("google"):
            return "globe"
        case let p where p.contains("apple"):
            return "applelogo"
        case let p where p.contains("facebook"):
            return "person.2.fill"
        default:
            return "arrow.right.circle"
        }
    }
}
