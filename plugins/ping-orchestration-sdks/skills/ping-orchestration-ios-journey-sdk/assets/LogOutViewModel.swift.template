/*
 * Logout ViewModel — handles session revocation and logout.
 *
 * INSTRUCTIONS:
 *   1. Place in YourApp/ViewModels/LogOutViewModel.swift
 */

import SwiftUI
import PingJourney
import PingOidc

@MainActor
class LogOutViewModel: ObservableObject {
    @Published var isLoading: Bool = false
    @Published var isLoggedOut: Bool = false
    @Published var error: String?

    func logout() async {
        isLoading = true
        error = nil
        do {
            try await journey.user()?.revoke()
            isLoggedOut = true
        } catch {
            self.error = error.localizedDescription
        }
        isLoading = false
    }
}
