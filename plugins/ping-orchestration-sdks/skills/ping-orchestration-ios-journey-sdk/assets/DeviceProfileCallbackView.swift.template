/*
 * Device Profile Callback View — auto-collects device metadata.
 * Requires: PingDeviceProfile module.
 *
 * INSTRUCTIONS:
 *   1. Place in YourApp/Callbacks/DeviceProfileCallbackView.swift
 *   2. Add PingDeviceProfile as an SPM dependency.
 */

import SwiftUI
import PingDeviceProfile

struct DeviceProfileCallbackView: View {
    let callback: DeviceProfileCallback
    let onNext: () -> Void

    @State private var error: String?

    var body: some View {
        VStack(spacing: 12) {
            if let error = error {
                ErrorMessageView(message: "Device profile collection failed: \(error)")
            } else {
                ProgressView("Collecting device profile...")
            }
        }
        .padding()
        .onAppear {
            Task {
                do {
                    try await callback.execute()
                    onNext()
                } catch {
                    self.error = error.localizedDescription
                }
            }
        }
    }
}
