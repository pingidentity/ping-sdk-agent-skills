/*
 * Name Callback View — text field for username input.
 *
 * INSTRUCTIONS:
 *   1. Place in YourApp/Callbacks/NameCallbackView.swift
 */

import SwiftUI
import PingJourney

struct NameCallbackView: View {
    let callback: NameCallback
    let onNodeUpdated: () -> Void

    @State private var text: String = ""

    var body: some View {
        VStack(alignment: .leading, spacing: 4) {
            TextField(callback.prompt, text: $text)
                .textFieldStyle(.roundedBorder)
                .textContentType(.username)
                .autocapitalization(.none)
                .disableAutocorrection(true)
                .onChange(of: text) { newValue in
                    callback.name = newValue
                }
                .onAppear {
                    text = callback.name
                }
        }
        .padding(.vertical, 4)
    }
}
