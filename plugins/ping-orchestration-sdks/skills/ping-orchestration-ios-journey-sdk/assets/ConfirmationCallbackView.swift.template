/*
 * Confirmation Callback View — action buttons (Yes/No, OK/Cancel).
 *
 * INSTRUCTIONS:
 *   1. Place in YourApp/Callbacks/ConfirmationCallbackView.swift
 */

import SwiftUI
import PingJourney

struct ConfirmationCallbackView: View {
    let callback: ConfirmationCallback
    let onNext: () -> Void

    var body: some View {
        VStack(spacing: 8) {
            if let prompt = callback.prompt, !prompt.isEmpty {
                Text(prompt)
                    .font(.subheadline)
                    .fontWeight(.medium)
            }

            HStack(spacing: 12) {
                ForEach(Array(callback.options.enumerated()), id: \.offset) { index, option in
                    Button(option) {
                        callback.selectedIndex = index
                        onNext()
                    }
                    .buttonStyle(.bordered)
                }
            }
        }
        .padding(.vertical, 8)
    }
}
