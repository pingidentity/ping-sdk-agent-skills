/*
 * Validated Username Callback View — username input with policy validation.
 *
 * INSTRUCTIONS:
 *   1. Place in YourApp/Callbacks/ValidatedUsernameCallbackView.swift
 */

import SwiftUI
import PingJourney

struct ValidatedUsernameCallbackView: View {
    let callback: ValidatedUsernameCallback
    let onNodeUpdated: () -> Void

    @State private var text: String = ""

    var body: some View {
        VStack(alignment: .leading, spacing: 4) {
            TextField(callback.prompt, text: $text)
                .textFieldStyle(.roundedBorder)
                .textContentType(.username)
                .autocapitalization(.none)
                .disableAutocorrection(true)
                .onChange(of: text) { newValue in
                    callback.name = newValue
                }
                .onAppear {
                    text = callback.name
                }

            // Display failed policy messages
            if !callback.failedPolicies.isEmpty {
                ForEach(callback.failedPolicies, id: \.self) { policy in
                    Text(policy)
                        .font(.caption)
                        .foregroundStyle(.red)
                }
            }
        }
        .padding(.vertical, 4)
    }
}
