/*
 * String Attribute Input Callback View — string attribute with validation.
 *
 * INSTRUCTIONS:
 *   1. Place in YourApp/Callbacks/StringAttributeInputCallbackView.swift
 */

import SwiftUI
import PingJourney

struct StringAttributeInputCallbackView: View {
    let callback: StringAttributeInputCallback
    let onNodeUpdated: () -> Void

    @State private var text: String = ""

    var body: some View {
        VStack(alignment: .leading, spacing: 4) {
            TextField(callback.prompt, text: $text)
                .textFieldStyle(.roundedBorder)
                .autocapitalization(.none)
                .disableAutocorrection(true)
                .keyboardType(keyboardType)
                .onChange(of: text) { newValue in
                    callback.value = newValue
                }
                .onAppear {
                    text = callback.value ?? ""
                }

            // Display failed policy messages
            if !callback.failedPolicies.isEmpty {
                ForEach(callback.failedPolicies, id: \.self) { policy in
                    Text(policy)
                        .font(.caption)
                        .foregroundStyle(.red)
                }
            }
        }
        .padding(.vertical, 4)
    }

    /// Adjust keyboard type based on the attribute name.
    private var keyboardType: UIKeyboardType {
        switch callback.name.lowercased() {
        case "mail", "email":
            return .emailAddress
        case "telephonenumber", "phone":
            return .phonePad
        default:
            return .default
        }
    }
}
