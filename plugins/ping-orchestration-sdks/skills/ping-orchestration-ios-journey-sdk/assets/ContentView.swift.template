/*
 * Content View — main navigation view with menu items.
 *
 * INSTRUCTIONS:
 *   1. Place in YourApp/Views/ContentView.swift
 *   2. Customize the menu items and navigation destinations as needed.
 */

import SwiftUI

struct ContentView: View {
    @State private var path: [MenuItem] = []

    var body: some View {
        NavigationStack(path: $path) {
            List {
                Section("Authentication") {
                    NavigationLink(value: MenuItem.journey) {
                        Label("Journey", systemImage: "person.badge.key")
                    }
                }

                Section("Session") {
                    NavigationLink(value: MenuItem.token) {
                        Label("Access Token", systemImage: "key.fill")
                    }
                    NavigationLink(value: MenuItem.user) {
                        Label("User Info", systemImage: "person.circle")
                    }
                }

                Section("Account") {
                    NavigationLink(value: MenuItem.logout) {
                        Label("Logout", systemImage: "rectangle.portrait.and.arrow.right")
                    }
                }
            }
            .navigationTitle("Ping SDK Demo")
            .navigationDestination(for: MenuItem.self) { item in
                switch item {
                case .journey:
                    JourneyView(path: $path)
                case .token:
                    AccessTokenView(menuItem: item)
                case .user:
                    UserInfoView(menuItem: item)
                case .logout:
                    LogOutView(path: $path)
                }
            }
        }
    }
}

#Preview {
    ContentView()
}
