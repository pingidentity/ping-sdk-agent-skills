/*
 * Access Token ViewModel — fetches the OAuth access token.
 *
 * INSTRUCTIONS:
 *   1. Place in YourApp/ViewModels/AccessTokenViewModel.swift
 */

import SwiftUI
import PingJourney
import PingOidc

@MainActor
class AccessTokenViewModel: ObservableObject {
    @Published var accessToken: String?
    @Published var idToken: String?
    @Published var refreshToken: String?
    @Published var expiry: String?
    @Published var isLoading: Bool = false
    @Published var error: String?

    func fetchToken(forceRenew: Bool = false) async {
        isLoading = true
        error = nil
        do {
            let user = journey.user()
            let token = try await user?.token(forceRenew: forceRenew)
            accessToken = token?.accessToken
            idToken = token?.idToken
            refreshToken = token?.refreshToken
            if let expiresIn = token?.expiresIn {
                expiry = "Expires in \(expiresIn) seconds"
            }
        } catch {
            self.error = error.localizedDescription
        }
        isLoading = false
    }
}
