/*
 * Text Output Callback View — displays read-only messages.
 * Also used for SuspendedTextOutputCallback.
 *
 * INSTRUCTIONS:
 *   1. Place in YourApp/Callbacks/TextOutputCallbackView.swift
 */

import SwiftUI
import PingJourney

struct TextOutputCallbackView: View {
    let callback: TextOutputCallback

    var body: some View {
        HStack(spacing: 8) {
            Image(systemName: iconName)
                .foregroundStyle(iconColor)

            Text(callback.message)
                .font(.subheadline)
        }
        .padding(12)
        .frame(maxWidth: .infinity, alignment: .leading)
        .background(backgroundColor)
        .clipShape(RoundedRectangle(cornerRadius: 8))
        .padding(.vertical, 4)
    }

    private var iconName: String {
        switch callback.messageType {
        case .warning:
            return "exclamationmark.triangle.fill"
        case .error:
            return "xmark.circle.fill"
        default:
            return "info.circle.fill"
        }
    }

    private var iconColor: Color {
        switch callback.messageType {
        case .warning:
            return .orange
        case .error:
            return .red
        default:
            return .blue
        }
    }

    private var backgroundColor: Color {
        switch callback.messageType {
        case .warning:
            return .orange.opacity(0.1)
        case .error:
            return .red.opacity(0.1)
        default:
            return .blue.opacity(0.1)
        }
    }
}
