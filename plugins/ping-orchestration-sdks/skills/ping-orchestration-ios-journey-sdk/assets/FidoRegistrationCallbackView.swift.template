/*
 * FIDO2 Registration Callback View — Passkey/WebAuthn registration.
 * Requires: PingFido module.
 *
 * INSTRUCTIONS:
 *   1. Place in YourApp/Callbacks/FidoRegistrationCallbackView.swift
 *   2. Add PingFido as an SPM dependency.
 *   3. Add Associated Domains capability with the webcredentials service.
 */

import SwiftUI
import PingFido

struct FidoRegistrationCallbackView: View {
    let callback: FidoRegistrationCallback
    let onNext: () -> Void

    @State private var status: String = "Registering passkey..."
    @State private var error: String?

    var body: some View {
        VStack(spacing: 12) {
            if let error = error {
                ErrorMessageView(message: "FIDO registration failed: \(error)")
            } else {
                ProgressView(status)
            }
        }
        .padding()
        .onAppear {
            Task {
                guard let window = UIApplication.shared.connectedScenes
                    .compactMap({ $0 as? UIWindowScene })
                    .first?.windows.first else {
                    error = "Unable to find active window"
                    return
                }

                let result = await callback.register(presentOn: window)
                switch result {
                case .success:
                    onNext()
                case .failure(let fidoError):
                    error = fidoError.localizedDescription
                }
            }
        }
    }
}
