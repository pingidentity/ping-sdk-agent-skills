/*
 * DaVinci ViewModel — orchestrates the DaVinci authentication flow.
 *
 * INSTRUCTIONS:
 *   1. Place in com/example/myapp/auth/DaVinciViewModel.kt
 *   2. Ensure `daVinci` (from DaVinciConfig.kt) is accessible in this package.
 */

package com.example.myapp.auth

import androidx.lifecycle.ViewModel
import androidx.lifecycle.viewModelScope
import com.pingidentity.davinci.user
import com.pingidentity.orchestrate.ContinueNode
import kotlinx.coroutines.flow.MutableStateFlow
import kotlinx.coroutines.flow.update
import kotlinx.coroutines.launch

class DaVinciViewModel : ViewModel() {

    /** Holds the current DaVinci node and a recomposition counter. */
    var state = MutableStateFlow(DaVinciState())
        private set

    /** True while an async DaVinci operation is in progress. */
    var loading = MutableStateFlow(false)
        private set

    init {
        // Auto-start the DaVinci flow when the ViewModel is created.
        start()
    }

    /**
     * (Re-)starts the DaVinci flow from the beginning.
     * Called on init and when the user presses Back.
     */
    fun start() {
        loading.update { true }
        viewModelScope.launch {
            val node = daVinci.start()
            state.update { it.copy(node = node) }
            loading.update { false }
        }
    }

    /**
     * Advances to the next node by submitting the current [ContinueNode]'s collectors.
     * Collectors must have been populated (e.g., value set) before calling this.
     */
    fun next(node: ContinueNode) {
        loading.update { true }
        viewModelScope.launch {
            val next = node.next()
            state.update { it.copy(node = next) }
            loading.update { false }
        }
    }

    /**
     * Triggers a recomposition of the current node without advancing the flow.
     * Useful when a collector value changes but the node reference stays the same.
     */
    fun refresh() {
        state.update { it.copy(counter = it.counter + 1) }
    }

    /**
     * Logs out the current user (revokes tokens).
     *
     * @param onCompleted Callback invoked after logout.
     */
    fun logout(onCompleted: () -> Unit) {
        viewModelScope.launch {
            daVinci.user()?.logout()
        }
        onCompleted()
    }
}
