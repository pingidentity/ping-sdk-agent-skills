package com.example.myapp.auth.collector

import androidx.compose.foundation.layout.fillMaxWidth
import androidx.compose.foundation.layout.padding
import androidx.compose.material3.OutlinedButton
import androidx.compose.material3.Text
import androidx.compose.runtime.Composable
import androidx.compose.runtime.rememberCoroutineScope
import androidx.compose.ui.Modifier
import androidx.compose.ui.platform.LocalContext
import androidx.compose.ui.unit.dp
import com.pingidentity.idp.davinci.IdpCollector
import com.pingidentity.orchestrate.ContinueNode
import kotlinx.coroutines.launch

/**
 * Renders a social login button for an [IdpCollector].
 * Launches the IdP OAuth flow when clicked.
 */
@Composable
fun SocialLoginButton(
    collector: IdpCollector,
    onStart: () -> Unit,
    onNext: (ContinueNode) -> Unit,
) {
    val context = LocalContext.current
    val scope = rememberCoroutineScope()

    OutlinedButton(
        onClick = {
            scope.launch {
                collector.authorize(context)
                onNext(collector.continueNode)
            }
        },
        modifier = Modifier
            .fillMaxWidth()
            .padding(vertical = 4.dp),
    ) {
        Text(collector.label)
    }
}
