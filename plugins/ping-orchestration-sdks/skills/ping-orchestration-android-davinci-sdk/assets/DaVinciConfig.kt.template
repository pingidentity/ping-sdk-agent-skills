package com.example.myapp.auth

import com.pingidentity.davinci.DaVinci
import com.pingidentity.davinci.module.Oidc
import com.pingidentity.logger.Logger
import com.pingidentity.logger.STANDARD

// ─── Configure these values ───────────────────────────────────────────────────
private const val CLIENT_ID         = "<your-client-id>"
private const val DISCOVERY_ENDPOINT =
    "https://auth.pingone.com/<your-env-id>/as/.well-known/openid-configuration"
private const val REDIRECT_URI      = "org.forgerock.demo:/oauth2redirect"
// ─────────────────────────────────────────────────────────────────────────────

/**
 * Singleton DaVinci instance.
 *
 * Usage:
 *   val node = daVinci.start()
 *   val user = daVinci.user()
 */
val daVinci = DaVinci {
    logger = Logger.STANDARD

    module(Oidc) {
        clientId          = CLIENT_ID
        discoveryEndpoint = DISCOVERY_ENDPOINT
        scopes            = mutableSetOf("openid", "email", "profile")
        redirectUri       = REDIRECT_URI

        // Optional: override token storage
        // storage = { MemoryStorage<Token>() }
    }
}
