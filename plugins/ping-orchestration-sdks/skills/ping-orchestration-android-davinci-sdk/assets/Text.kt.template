package com.example.myapp.auth.collector

import androidx.compose.foundation.layout.fillMaxWidth
import androidx.compose.material3.OutlinedTextField
import androidx.compose.material3.Text
import androidx.compose.runtime.Composable
import androidx.compose.runtime.getValue
import androidx.compose.runtime.mutableStateOf
import androidx.compose.runtime.remember
import androidx.compose.runtime.setValue
import androidx.compose.ui.Modifier
import com.pingidentity.davinci.collector.TextCollector

/**
 * Renders a text input field for a [TextCollector].
 */
@Composable
fun Text(collector: TextCollector, onNodeUpdated: () -> Unit) {
    var text by remember { mutableStateOf(collector.value) }
    val errors = remember { mutableStateOf<List<Any>>(emptyList()) }

    OutlinedTextField(
        value = text,
        onValueChange = {
            text = it
            collector.value = it
            errors.value = collector.validate()
            onNodeUpdated()
        },
        label = { Text(collector.label) },
        isError = errors.value.isNotEmpty(),
        supportingText = if (errors.value.isNotEmpty()) {
            { Text(errors.value.joinToString(", ") { it.toString() }) }
        } else null,
        singleLine = true,
        modifier = Modifier.fillMaxWidth(),
    )
}
