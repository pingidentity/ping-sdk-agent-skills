/*
 * Login View
 *
 * INSTRUCTIONS:
 *   Place in client/views/login.jsx
 *
 * Renders the authentication form using the login Journey/Tree.
 * Supports both embedded login (default) and centralized (redirect) login.
 */

import { useContext, useEffect } from 'react';
import { Link, useNavigate, useSearchParams } from 'react-router-dom';
import Form from '../components/journey/form';
import { OidcContext } from '../context/oidc.context';
import { CENTRALIZED_LOGIN } from '../constants';

/**
 * @function Login — React view for the login page
 */
export default function Login() {
  const navigate = useNavigate();
  const [searchParams] = useSearchParams();
  const [{ isAuthenticated, oidcClient }, { setAuthentication, setUser }] =
    useContext(OidcContext);

  // If already authenticated, redirect to home
  useEffect(() => {
    if (isAuthenticated) {
      navigate('/');
    }
  }, [isAuthenticated, navigate]);

  // ── Centralized Login Mode ──────────────────────────────────────────────
  if (CENTRALIZED_LOGIN === 'true') {
    const codeParam = searchParams.get('code');
    const errorParam = searchParams.get('error');
    const stateParam = searchParams.get('state');

    useEffect(() => {
      async function handleCentralizedLogin() {
        if (!oidcClient) return;

        if (codeParam && stateParam) {
          // Exchange authorization code for tokens
          const tokenResponse = await oidcClient.token.exchange(codeParam, stateParam);
          if (!('error' in tokenResponse)) {
            const userInfo = await oidcClient.user.info();
            if (!('error' in userInfo)) {
              setUser(userInfo);
            }
            setAuthentication(true);
            navigate('/');
          }
        } else if (errorParam) {
          // Authorization server returned an error (e.g. access_denied)
          console.error(`Centralized login error: ${errorParam}`);
        } else {
          // No params yet — redirect to authorization endpoint
          const authUrl = await oidcClient.authorize.url();
          if (typeof authUrl === 'string') {
            window.location.assign(authUrl);
          }
        }
      }
      handleCentralizedLogin();
    }, [codeParam, errorParam, stateParam, oidcClient]); // eslint-disable-line react-hooks/exhaustive-deps

    return <p>Redirecting to login...</p>;
  }

  // ── Embedded Login Mode (default) ──────────────────────────────────────
  return (
    <div>
      <Form
        action={{ type: 'login' }}
        topMessage={
          <p>
            Don't have an account? <Link to="/register">Register here!</Link>
          </p>
        }
      />
    </div>
  );
}
