/*
 * SelectIdP Callback Component
 *
 * INSTRUCTIONS:
 *   Place in client/components/journey/select-idp.jsx
 *
 * Handles: SelectIdPCallback
 *
 * Renders buttons for each available external Identity Provider (Google,
 * Facebook, Apple, etc.). Selecting a provider sets the value on the callback.
 *
 * SDK integration points:
 *   - callback.getProviders()     → array of { provider, uiConfig }
 *   - callback.setProvider(id)    → set the selected provider ID
 */

/**
 * @function SelectIdP — Renders identity provider selection buttons
 * @param {Object} props
 * @param {Object} props.callback — The callback object from PingAM
 * @param {string} props.inputName — Unique input name for the field
 * @param {Function} props.onSubmit — Submit handler to advance the step after selection
 */
export default function SelectIdP({ callback, inputName, onSubmit }) {
  const providers = callback.getProviders();

  function selectProvider(providerId) {
    callback.setProvider(providerId);
    if (onSubmit) {
      onSubmit();
    }
  }

  return (
    <div style={{ marginBottom: '1rem' }}>
      <p>Sign in with:</p>
      {providers.map((provider) => (
        <button
          key={provider.provider}
          type="button"
          onClick={() => selectProvider(provider.provider)}
          style={{
            display: 'block',
            width: '100%',
            padding: '0.75rem',
            marginBottom: '0.5rem',
            cursor: 'pointer',
          }}
        >
          {provider.uiConfig?.buttonDisplayName || provider.provider}
        </button>
      ))}
    </div>
  );
}
