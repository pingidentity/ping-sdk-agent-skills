/*
 * Application Router
 *
 * INSTRUCTIONS:
 *   Place in client/router.jsx
 *
 * Defines the application routes using React Router v6.
 * Protected routes are wrapped with the ProtectedRoute component.
 */

import { BrowserRouter, Routes, Route } from 'react-router-dom';
import { ProtectedRoute } from './components/utilities/route';
import Home from './views/home';
import Login from './views/login';
import Logout from './views/logout';
import Register from './views/register';

/**
 * @function Router — Application route definitions
 */
export default function Router() {
  return (
    <BrowserRouter>
      <Routes>
        {/* Public routes */}
        <Route path="/" element={<Home />} />
        <Route path="/login" element={<Login />} />
        <Route path="/register" element={<Register />} />
        <Route path="/logout" element={<Logout />} />

        {/* Protected routes — add your authenticated routes here */}
        {/*
        <Route
          path="/dashboard"
          element={
            <ProtectedRoute>
              <Dashboard />
            </ProtectedRoute>
          }
        />
        */}
      </Routes>
    </BrowserRouter>
  );
}
