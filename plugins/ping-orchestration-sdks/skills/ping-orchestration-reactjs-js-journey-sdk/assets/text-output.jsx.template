/*
 * Text Output Callback Component
 *
 * INSTRUCTIONS:
 *   Place in client/components/journey/text-output.jsx
 *
 * Handles: TextOutputCallback
 *
 * SDK integration points:
 *   - callback.getMessage()     → the server message to display
 *   - callback.getMessageType() → 0=INFO, 1=WARNING, 2=ERROR, 4=SCRIPT
 */

/**
 * @function TextOutput — Renders a server-provided text message (no user input)
 * @param {Object} props
 * @param {Object} props.callback — The callback object from PingAM
 */
export default function TextOutput({ callback }) {
  const message = callback.getMessage();
  const messageType = callback.getMessageType && callback.getMessageType();

  let style = { marginBottom: '0.5rem' };
  if (messageType === 2) {
    style.color = 'red';
  } else if (messageType === 1) {
    style.color = 'orange';
  }

  return <p style={style}>{message}</p>;
}
