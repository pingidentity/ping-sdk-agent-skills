/*
 * Boolean Callback Component
 *
 * INSTRUCTIONS:
 *   Place in client/components/journey/boolean.jsx
 *
 * Handles: BooleanAttributeInputCallback
 *
 * SDK integration points:
 *   - callback.getPrompt()        → label text
 *   - callback.getInputValue()    → current boolean value
 *   - callback.setInputValue(val) → set the boolean value
 */

/**
 * @function Boolean — Renders a checkbox for boolean attribute callbacks
 * @param {Object} props
 * @param {Object} props.callback — The callback object from PingAM
 * @param {string} props.inputName — Unique input name for the field
 */
export default function BooleanComponent({ callback, inputName }) {
  const prompt = callback.getPrompt();
  const value = callback.getInputValue();

  function setValue(event) {
    callback.setInputValue(event.target.checked);
  }

  return (
    <div style={{ marginBottom: '1rem' }}>
      <label style={{ display: 'flex', alignItems: 'center', gap: '0.5rem' }}>
        <input
          id={inputName}
          type="checkbox"
          defaultChecked={value}
          onChange={setValue}
        />
        {prompt}
      </label>
    </div>
  );
}
