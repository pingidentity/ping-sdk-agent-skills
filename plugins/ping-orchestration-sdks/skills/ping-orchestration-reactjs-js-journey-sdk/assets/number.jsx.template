/*
 * NumberAttributeInput Callback Component
 *
 * INSTRUCTIONS:
 *   Place in client/components/journey/number.jsx
 *
 * Handles: NumberAttributeInputCallback
 *
 * SDK integration points:
 *   - callback.getPrompt()        → label text
 *   - callback.getInputValue()    → current numeric value
 *   - callback.getName()          → attribute name
 *   - callback.setInputValue(val) → set the numeric value
 */

/**
 * @function NumberInput — Renders a number input for NumberAttributeInputCallback
 * @param {Object} props
 * @param {Object} props.callback — The callback object from PingAM
 * @param {string} props.inputName — Unique input name for the field
 */
export default function NumberInput({ callback, inputName }) {
  const prompt = callback.getPrompt();
  const currentValue = callback.getInputValue();

  function setValue(event) {
    const num = Number(event.target.value);
    if (!isNaN(num)) {
      callback.setInputValue(num);
    }
  }

  return (
    <div style={{ marginBottom: '1rem' }}>
      <label htmlFor={inputName}>{prompt}</label>
      <input
        id={inputName}
        name={inputName}
        type="number"
        defaultValue={currentValue}
        onChange={setValue}
        placeholder={prompt}
        style={{ display: 'block', width: '100%', padding: '0.5rem' }}
      />
    </div>
  );
}
