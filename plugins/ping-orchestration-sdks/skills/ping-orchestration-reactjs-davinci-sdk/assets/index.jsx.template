import React from 'react';
import ReactDOM from 'react-dom/client';
import { DAVINCI_CONFIG } from './constants';
import { useInitOidcState, OidcContext } from './context/oidc.context';
import Router from './router';

// React.StrictMode is intentionally omitted — it double-fires useEffect in dev,
// which causes davinci.start() and oidc() to run twice, breaking the auth flow.
function App() {
  const oidcState = useInitOidcState(DAVINCI_CONFIG);
  const [{ oidcClient }] = oidcState;

  if (!oidcClient) {
    return <p>Initializing…</p>;
  }

  return (
    <OidcContext.Provider value={oidcState}>
      <Router />
    </OidcContext.Provider>
  );
}

ReactDOM.createRoot(document.getElementById('root')).render(<App />);
