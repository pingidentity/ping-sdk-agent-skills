import React from 'react';

/**
 * Renders a text input for a TextCollector.
 *
 * @param {object}   props
 * @param {object}   props.collector  - The TextCollector from DaVinci.
 * @param {string}   props.inputName  - Unique field name (collector.name).
 * @param {Function} props.updater    - Pre-called updater: davinciClient.update(collector).
 */
export default function TextCollector({ collector, inputName, updater }) {
  return (
    <div style={{ marginBottom: '1rem' }}>
      <label htmlFor={inputName}>{collector.output?.label || inputName}</label>
      <input
        id={inputName}
        name={inputName}
        type="text"
        onChange={(e) => updater(e.target.value)}
        style={{ display: 'block', width: '100%', padding: '0.5rem' }}
      />
    </div>
  );
}
