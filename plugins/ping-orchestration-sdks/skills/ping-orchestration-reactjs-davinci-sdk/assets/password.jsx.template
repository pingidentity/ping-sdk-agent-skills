import React, { useState } from 'react';

/**
 * Renders a password input with visibility toggle for a PasswordCollector.
 *
 * @param {object}   props
 * @param {object}   props.collector  - The PasswordCollector from DaVinci.
 * @param {string}   props.inputName  - Unique field name (collector.name).
 * @param {Function} props.updater    - Pre-called updater: davinciClient.update(collector).
 */
export default function PasswordCollector({ collector, inputName, updater }) {
  const [visible, setVisible] = useState(false);
  return (
    <div style={{ marginBottom: '1rem' }}>
      <label htmlFor={inputName}>{collector.output?.label || inputName}</label>
      <div style={{ display: 'flex', alignItems: 'center' }}>
        <input
          id={inputName}
          name={inputName}
          type={visible ? 'text' : 'password'}
          onChange={(e) => updater(e.target.value)}
          style={{ flex: 1, padding: '0.5rem' }}
        />
        <button
          type="button"
          onClick={() => setVisible(v => !v)}
          style={{ marginLeft: '0.5rem' }}
          aria-label={visible ? 'Hide password' : 'Show password'}
        >
          {visible ? '🙈' : '👁️'}
        </button>
      </div>
    </div>
  );
}
