import { useEffect } from 'react';

/**
 * Auto-advancing collector for PingOne Protect risk signal collection.
 *
 * This component collects device signals in the background and automatically
 * advances the flow — no visible UI is rendered.
 *
 * @param {object}   props
 * @param {object}   props.collector - The ProtectCollector from DaVinci.
 * @param {object}   props.client    - The DaVinci client instance.
 * @param {Function} props.onNext    - Callback that submits the current node.
 */
export default function Protect({ collector, client, onNext }) {
  useEffect(() => {
    let cancelled = false;

    async function collectSignals() {
      try {
        // If @forgerock/protect is available, collect real signals.
        // Otherwise, send an empty string to let the server handle it.
        let signals = '';

        try {
          const protectModule = await import('@forgerock/protect');
          signals = await protectModule.protect.collectSignals();
        } catch {
          // @forgerock/protect not installed — proceed without signals.
          console.warn('PingOne Protect SDK not available, skipping signal collection.');
        }

        if (cancelled) return;

        const updater = client.update(collector);
        updater(signals);

        await onNext();
      } catch (err) {
        console.error('Protect signal collection failed:', err);
      }
    }

    collectSignals();

    return () => {
      cancelled = true;
    };
  }, [collector, client, onNext]);

  // No visible UI — signals are collected silently.
  return null;
}
