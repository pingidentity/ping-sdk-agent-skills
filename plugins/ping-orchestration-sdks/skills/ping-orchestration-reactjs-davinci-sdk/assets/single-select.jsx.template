import React, { useState } from 'react';

/**
 * Renders a dropdown or radio group for a SingleSelectCollector.
 *
 * @param {object} props
 * @param {object} props.collector - The SingleSelectCollector from DaVinci.
 * @param {object} props.client    - The DaVinci client instance.
 */
export default function SingleSelect({ collector, client }) {
  const [selected, setSelected] = useState(collector.input?.value || '');
  const options = collector.output?.options || [];

  const handleChange = (e) => {
    const newValue = e.target.value;
    setSelected(newValue);

    const updater = client.update(collector);
    updater(newValue);
  };

  return (
    <div className="collector-field">
      <label htmlFor={collector.id}>
        {collector.output?.label || 'Select an option'}
      </label>
      <select id={collector.id} value={selected} onChange={handleChange}>
        <option value="" disabled>
          -- Select --
        </option>
        {options.map((opt) => (
          <option key={opt.value} value={opt.value}>
            {opt.label}
          </option>
        ))}
      </select>
      {collector.error && (
        <p className="field-error" role="alert">
          {collector.error}
        </p>
      )}
    </div>
  );
}
