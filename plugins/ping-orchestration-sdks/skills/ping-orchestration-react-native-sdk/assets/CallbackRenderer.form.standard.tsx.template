/*
 * CallbackRenderer.tsx — Managed form variant (useJourneyForm), Standard tier
 *
 * Covers everything in Basic tier plus:
 * FidoRegistration, FidoAuthentication (requires @ping-identity/rn-fido),
 * DeviceBinding, DeviceSigningVerifier (requires @ping-identity/rn-binding),
 * DeviceProfile (requires @ping-identity/rn-device-profile).
 *
 * Does NOT include SelectIdp / external IdP (use Full tier for that).
 */

import React from 'react';
import { ScrollView, StyleSheet, View } from 'react-native';
import type { JourneyNode, JourneyClient, JourneyNextInput, JourneyCallbackType } from '@ping-identity/rn-journey';
import { useJourneyForm } from '@ping-identity/rn-journey';
import {
  PingErrorMessage,
  PingPrimaryButton,
  PingSecureField,
  PingTextField,
} from './theme/PingTheme';
import { TextOutputCallbackView } from './callbacks/TextOutputCallbackView';
import { SuspendedTextOutputCallbackView } from './callbacks/SuspendedTextOutputCallbackView';
import { ChoiceCallbackView } from './callbacks/ChoiceCallbackView';
import { ConfirmationCallbackView } from './callbacks/ConfirmationCallbackView';
import { TermsAndConditionsCallbackView } from './callbacks/TermsAndConditionsCallbackView';
import { ConsentMappingCallbackView } from './callbacks/ConsentMappingCallbackView';
import { KbaCreateCallbackView } from './callbacks/KbaCreateCallbackView';
import { PollingWaitCallbackView } from './callbacks/PollingWaitCallbackView';
import { FidoRegistrationCallbackView } from './callbacks/FidoRegistrationCallbackView';
import { FidoAuthenticationCallbackView } from './callbacks/FidoAuthenticationCallbackView';
import { DeviceBindingCallbackView } from './callbacks/DeviceBindingCallbackView';
import { DeviceSigningVerifierCallbackView } from './callbacks/DeviceSigningVerifierCallbackView';
import { DeviceProfileCallbackView } from './callbacks/DeviceProfileCallbackView';
import { UnsupportedCallbackView } from './callbacks/UnsupportedCallbackView';

type Props = {
  node: JourneyNode;
  journeyClient: JourneyClient;
  onSubmit: (input: JourneyNextInput) => Promise<unknown>;
};

const HANDLED_CALLBACKS = new Set<JourneyCallbackType>([
  'FidoRegistrationCallback',
  'FidoAuthenticationCallback',
  'DeviceBindingCallback',
  'DeviceSigningVerifierCallback',
  'DeviceProfileCallback',
]);

export function CallbackRenderer({ node, journeyClient, onSubmit }: Props) {
  const form = useJourneyForm(node, { handledCallbackTypes: HANDLED_CALLBACKS });
  const { fields, values, setValue, setValues, canSubmit, issues, meta } = form;
  const [attempted, setAttempted] = React.useState(false);

  const handleNext = async () => { setAttempted(true); if (!canSubmit) return; await onSubmit(form.input); };

  const visibleFields = fields.filter((f) => f.ref.type !== 'HiddenValueCallback');
  const hasManualSubmit = meta.hasManual || (visibleFields.length === 0 && fields.length > 0);

  return (
    <ScrollView contentContainerStyle={styles.container} keyboardShouldPersistTaps="handled">
      {fields.map((field) => {
        const cb = field.raw;

        if (field.ref.type === 'HiddenValueCallback') {
          return null;
        }

        // DeviceProfileCallback is output_only (no user input) but requires native data collection,
        // not a static text view — intercept before the generic output_only branch.
        if (field.ref.type === 'DeviceProfileCallback') {
          return <DeviceProfileCallbackView key={field.id} journey={journeyClient} typeIndex={field.ref.typeIndex} onNext={() => { onSubmit(form.input); }} />;
        }

        // PollingWaitCallback is output_only (no user input) but needs timer-based auto-advance,
        // not a static text view — intercept before the generic output_only branch.
        if (field.ref.type === 'PollingWaitCallback') {
          return <PollingWaitCallbackView key={field.id} cb={cb} onNext={() => { onSubmit(form.input); }} />;
        }

        if (field.executionMode === 'output_only') {
          if (field.ref.type === 'SuspendedTextOutputCallback') {
            return <SuspendedTextOutputCallbackView key={field.id} cb={cb} />;
          }
          return <TextOutputCallbackView key={field.id} cb={cb} />;
        }

        if (field.executionMode === 'integration_required') {
          switch (field.ref.type) {
            case 'FidoRegistrationCallback':
              return <FidoRegistrationCallbackView key={field.id} journey={journeyClient} typeIndex={field.ref.typeIndex} onNext={() => { onSubmit(form.input); }} />;
            case 'FidoAuthenticationCallback':
              return <FidoAuthenticationCallbackView key={field.id} journey={journeyClient} typeIndex={field.ref.typeIndex} onNext={() => { onSubmit(form.input); }} />;
            case 'DeviceBindingCallback':
              return <DeviceBindingCallbackView key={field.id} journey={journeyClient} typeIndex={field.ref.typeIndex} onNext={() => { onSubmit(form.input); }} />;
            case 'DeviceSigningVerifierCallback':
              return <DeviceSigningVerifierCallbackView key={field.id} journey={journeyClient} typeIndex={field.ref.typeIndex} onNext={() => { onSubmit(form.input); }} />;
            default:
              return <UnsupportedCallbackView key={field.id} executionMode={field.executionMode} callbackType={field.ref.type} />;
          }
        }

        if (field.executionMode === 'unsupported') {
          return <UnsupportedCallbackView key={field.id} executionMode={field.executionMode} callbackType={field.ref.type} />;
        }

        switch (field.ref.type) {
          case 'TermsAndConditionsCallback':
            return <TermsAndConditionsCallbackView key={field.id} cb={cb} onValueChange={(v) => setValue(field.id, v)} />;
          case 'ConsentMappingCallback':
            return <ConsentMappingCallbackView key={field.id} cb={cb} onValueChange={(v) => setValue(field.id, v)} />;
          case 'KbaCreateCallback':
            return (
              <KbaCreateCallbackView
                key={field.id}
                cb={cb}
                onQuestionChange={(q) =>
                  setValues((prev) => {
                    const cur = prev[field.id] as { selectedQuestion?: string; selectedAnswer?: string; allowUserDefinedQuestions?: boolean } | undefined;
                    return { [field.id]: { selectedQuestion: q, selectedAnswer: cur?.selectedAnswer ?? '', allowUserDefinedQuestions: cur?.allowUserDefinedQuestions ?? false } };
                  })
                }
                onAnswerChange={(a) =>
                  setValues((prev) => {
                    const cur = prev[field.id] as { selectedQuestion?: string; selectedAnswer?: string; allowUserDefinedQuestions?: boolean } | undefined;
                    return { [field.id]: { selectedQuestion: cur?.selectedQuestion ?? '', selectedAnswer: a, allowUserDefinedQuestions: cur?.allowUserDefinedQuestions ?? false } };
                  })
                }
              />
            );
          default:
            break;
        }

        if (field.kind === 'password') {
          return <PingSecureField key={field.id} label={field.prompt} value={String(values[field.id] ?? '')} onChangeText={(v) => setValue(field.id, v)} placeholder={field.prompt} />;
        }
        if (field.kind === 'choice') {
          return <ChoiceCallbackView key={field.id} cb={cb} prompt={field.prompt} onValueChange={(v) => setValue(field.id, v)} />;
        }
        if (field.kind === 'boolean') {
          return <ConfirmationCallbackView key={field.id} cb={cb} prompt={field.prompt} onValueChange={(v) => setValue(field.id, v)} />;
        }
        return <PingTextField key={field.id} label={field.prompt} value={String(values[field.id] ?? '')} onChangeText={(v) => setValue(field.id, v)} placeholder={field.prompt} />;
      })}

      {attempted && !canSubmit && issues.some((i) => i.code !== 'REQUIRED_CONSENT_MISSING') ? (
        <PingErrorMessage message={issues.find((i) => i.code !== 'REQUIRED_CONSENT_MISSING')?.message ?? 'Please complete all fields.'} />
      ) : null}

      {hasManualSubmit ? (
        <View style={styles.buttonRow}>
          <PingPrimaryButton title="Next" onPress={handleNext} disabled={!canSubmit} />
        </View>
      ) : null}
    </ScrollView>
  );
}

const styles = StyleSheet.create({
  container: { padding: 16, gap: 4 },
  buttonRow: { marginTop: 16 },
});
