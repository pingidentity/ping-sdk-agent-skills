/*
 * PasswordCallbackView.tsx — Journey Basic tier
 *
 * Renders a secure password field for PasswordCallback.
 * Never log or display the value.
 */

import React, { useEffect, useState } from 'react';
import type { JourneyCallback } from '@ping-identity/rn-journey';
import { PingSecureField } from '../theme/PingTheme';

type Props = {
  cb: JourneyCallback;
  onValueChange: (value: string) => void;
};

export function PasswordCallbackView({ cb, onValueChange }: Props) {
  const [text, setText] = useState(String(cb.value ?? ''));

  // Emit initial value on mount so CallbackRenderer.values is seeded even if the
  // user never types (server often sends cb.value = '' for a pre-filled default).
  useEffect(() => {
    onValueChange(text);
  // eslint-disable-next-line react-hooks/exhaustive-deps
  }, []);

  const handleChange = (v: string) => {
    setText(v);
    onValueChange(v);
  };

  return (
    <PingSecureField
      label={cb.prompt ?? 'Password'}
      value={text}
      onChangeText={handleChange}
      placeholder={cb.prompt ?? 'Enter password'}
    />
  );
}
