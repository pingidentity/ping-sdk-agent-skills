/*
 * ValidatedPasswordCallbackView.tsx — Journey Standard tier
 *
 * Bridge alias: ValidatedCreatePasswordCallback (renamed from ValidatedPasswordCallback).
 * Same UI as PasswordCallbackView — never pre-populated (bridge always sends value: "").
 * Validation failures arrive as cb.failedPolicies[] on the next node — not client-side.
 */

import React, { useEffect, useState } from 'react';
import type { JourneyCallback } from '@ping-identity/rn-journey';
import { PingSecureField } from '../theme/PingTheme';

type Props = {
  cb: JourneyCallback;
  onValueChange: (value: string) => void;
};

export function ValidatedPasswordCallbackView({ cb, onValueChange }: Props) {
  const [text, setText] = useState(String(cb.value ?? ''));

  useEffect(() => {
    onValueChange(text);
  // eslint-disable-next-line react-hooks/exhaustive-deps
  }, []);

  const handleChange = (v: string) => {
    setText(v);
    onValueChange(v);
  };

  return (
    <PingSecureField
      label={String(cb.prompt ?? 'Password')}
      value={text}
      onChangeText={handleChange}
      placeholder={String(cb.prompt ?? 'Enter password')}
    />
  );
}
