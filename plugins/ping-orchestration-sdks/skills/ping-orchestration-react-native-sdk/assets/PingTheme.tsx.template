 */

import React from 'react';
import {
  ActivityIndicator,
  Image,
  ImageStyle,
  Modal,
  StyleSheet,
  Text,
  TextInput,
  TextStyle,
  TouchableOpacity,
  View,
  ViewStyle,
} from 'react-native';

// ---------------------------------------------------------------------------
// Color tokens
// ---------------------------------------------------------------------------

export const PingColors = {
  red:          '#A31300',   // RGB 163, 19, 0 — primary brand red
  redDark:      '#991A1A',   // gradient end
  textField:    '#DCE6E6',   // input field border (unfocused)
  white:        '#FFFFFF',
  black:        '#000000',
  errorText:    '#B00020',
  surface:      '#FFFFFF',
  background:   '#F5F5F5',
  onSurface:    '#1C1B1F',
  outline:      '#79747E',
  overlayBg:    'rgba(0,0,0,0.35)',
} as const;

// ---------------------------------------------------------------------------
// Primary action button
// ---------------------------------------------------------------------------

type PingPrimaryButtonProps = {
  title:    string;
  onPress:  () => void;
  disabled?: boolean;
};

export function PingPrimaryButton({ title, onPress, disabled = false }: PingPrimaryButtonProps) {
  return (
    <TouchableOpacity
      onPress={onPress}
      disabled={disabled}
      activeOpacity={0.85}
      style={[styles.primaryButton, disabled && styles.primaryButtonDisabled]}
    >
      <Text style={styles.primaryButtonText}>{title}</Text>
    </TouchableOpacity>
  );
}

// ---------------------------------------------------------------------------
// Branded header (gradient-like background + logo + title + subtitle)
// ---------------------------------------------------------------------------

type PingHeaderViewProps = {
  title:    string;
  subtitle: string;
};

export function PingHeaderView({ title, subtitle }: PingHeaderViewProps) {
  return (
    <View style={styles.header}>
      <Image
        // eslint-disable-next-line @typescript-eslint/no-require-imports
        source={require('../assets/ping_logo.png')}
        style={styles.logo as ImageStyle}
        resizeMode="contain"
      />
      <Text style={styles.headerTitle}>{title}</Text>
      <Text style={styles.headerSubtitle}>{subtitle}</Text>
    </View>
  );
}

// ---------------------------------------------------------------------------
// Branded text field
// ---------------------------------------------------------------------------

type PingTextFieldProps = {
  value:         string;
  onChangeText:  (text: string) => void;
  placeholder?:  string;
  label?:        string;
  autoCapitalize?: 'none' | 'sentences' | 'words' | 'characters';
  keyboardType?: 'default' | 'email-address' | 'numeric' | 'phone-pad';
};

export function PingTextField({
  value,
  onChangeText,
  placeholder,
  label,
  autoCapitalize = 'none',
  keyboardType = 'default',
}: PingTextFieldProps) {
  return (
    <View style={styles.fieldContainer}>
      {label ? <Text style={styles.fieldLabel}>{label}</Text> : null}
      <TextInput
        value={value}
        onChangeText={onChangeText}
        placeholder={placeholder}
        autoCapitalize={autoCapitalize}
        keyboardType={keyboardType}
        style={styles.textInput}
        placeholderTextColor={PingColors.outline}
      />
    </View>
  );
}

// ---------------------------------------------------------------------------
// Branded secure field (password)
// ---------------------------------------------------------------------------

type PingSecureFieldProps = {
  value:        string;
  onChangeText: (text: string) => void;
  placeholder?: string;
  label?:       string;
};

export function PingSecureField({ value, onChangeText, placeholder, label }: PingSecureFieldProps) {
  const [visible, setVisible] = React.useState(false);
  return (
    <View style={styles.fieldContainer}>
      {label ? <Text style={styles.fieldLabel}>{label}</Text> : null}
      <View style={styles.secureRow}>
        <TextInput
          value={value}
          onChangeText={onChangeText}
          placeholder={placeholder}
          secureTextEntry={!visible}
          autoCapitalize="none"
          style={[styles.textInput, styles.secureInput]}
          placeholderTextColor={PingColors.outline}
        />
        <TouchableOpacity onPress={() => setVisible((v) => !v)} style={styles.eyeButton}>
          <Text style={styles.eyeIcon}>{visible ? 'Hide' : 'Show'}</Text>
        </TouchableOpacity>
      </View>
    </View>
  );
}

// ---------------------------------------------------------------------------
// Inline error message
// ---------------------------------------------------------------------------

type PingErrorMessageProps = {
  message: string;
};

export function PingErrorMessage({ message }: PingErrorMessageProps) {
  return (
    <View style={styles.errorRow}>
      <Text style={styles.errorIcon}>⚠</Text>
      <Text style={styles.errorText}>{message}</Text>
    </View>
  );
}

// ---------------------------------------------------------------------------
// Full-screen error card (unrecoverable / failure state)
// ---------------------------------------------------------------------------

type PingErrorCardProps = {
  message:  string;
  onRetry?: () => void;
};

export function PingErrorCard({ message, onRetry }: PingErrorCardProps) {
  return (
    <View style={styles.errorCard}>
      <Text style={styles.errorCardIcon}>⚠</Text>
      <Text style={styles.errorCardTitle}>Something went wrong</Text>
      <Text style={styles.errorCardMessage}>{message}</Text>
      {onRetry ? (
        <PingPrimaryButton title="Try Again" onPress={onRetry} />
      ) : null}
    </View>
  );
}

// ---------------------------------------------------------------------------
// Loading overlay (full-screen blocking spinner)
// ---------------------------------------------------------------------------

type PingLoadingOverlayProps = {
  visible:   boolean;
  message?:  string;
};

export function PingLoadingOverlay({ visible, message = 'Loading…' }: PingLoadingOverlayProps) {
  return (
    <Modal transparent animationType="fade" visible={visible}>
      <View style={styles.overlayBg}>
        <View style={styles.overlayCard}>
          <ActivityIndicator size="large" color={PingColors.red} />
          <Text style={styles.overlayMessage}>{message}</Text>
        </View>
      </View>
    </Modal>
  );
}

