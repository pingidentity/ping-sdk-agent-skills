/*
 * SingleSelectCollectorView.tsx: DaVinci core collector
 *
 * Renders a single-choice list for SINGLE_SELECT, DROPDOWN and RADIO collectors.
 * Submit key: collector.key. Payload value: string (one of collector.options[].value).
 */

import React from 'react';
import { StyleSheet, Text, TouchableOpacity, View } from 'react-native';
import type {
  DaVinciFormValue,
  SingleSelectCollector,
} from '@ping-identity/rn-davinci';
import { PingColors } from '../theme/PingTheme';

type Props = {
  collector: SingleSelectCollector;
  value: DaVinciFormValue | undefined;
  onChange: (value: string) => void;
};

/**
 * Renders a single-choice list for a SINGLE_SELECT, DROPDOWN or RADIO collector.
 *
 * @returns The option list element.
 */
export function SingleSelectCollectorView({
  collector,
  value,
  onChange,
}: Props): React.ReactElement {
  const selected = typeof value === 'string' ? value : collector.value;

  return (
    <View style={styles.container}>
      <Text style={styles.label}>
        {collector.required ? `${collector.label} *` : collector.label}
      </Text>
      {collector.options.map((option) => {
        const isSelected = selected === option.value;
        return (
          <TouchableOpacity
            key={option.value}
            onPress={() => onChange(option.value)}
            style={[styles.option, isSelected && styles.optionSelected]}
            activeOpacity={0.75}
            accessibilityRole="radio"
            accessibilityState={{ selected: isSelected }}
          >
            <View style={[styles.radio, isSelected && styles.radioSelected]}>
              {isSelected && <View style={styles.radioDot} />}
            </View>
            <Text style={styles.optionText}>{option.label}</Text>
          </TouchableOpacity>
        );
      })}
    </View>
  );
}

const styles = StyleSheet.create({
  container: {
    width: '100%',
    marginBottom: 12,
  },
  label: {
    fontSize: 13,
    fontWeight: '500',
    color: PingColors.onSurface,
    marginBottom: 8,
  },
  option: {
    flexDirection: 'row',
    alignItems: 'center',
    paddingVertical: 10,
    paddingHorizontal: 12,
    borderRadius: 8,
    borderWidth: 1,
    borderColor: PingColors.textField,
    marginBottom: 6,
    backgroundColor: PingColors.surface,
  },
  optionSelected: {
    borderColor: PingColors.red,
    backgroundColor: '#FFF5F4',
  },
  radio: {
    width: 18,
    height: 18,
    borderRadius: 9,
    borderWidth: 2,
    borderColor: PingColors.outline,
    alignItems: 'center',
    justifyContent: 'center',
    marginRight: 10,
  },
  radioSelected: {
    borderColor: PingColors.red,
  },
  radioDot: {
    width: 8,
    height: 8,
    borderRadius: 4,
    backgroundColor: PingColors.red,
  },
  optionText: {
    fontSize: 14,
    color: PingColors.onSurface,
    flexShrink: 1,
  },
});
