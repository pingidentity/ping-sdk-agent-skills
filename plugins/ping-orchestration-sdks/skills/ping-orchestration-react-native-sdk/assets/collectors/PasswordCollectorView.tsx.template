/*
 * PasswordCollectorView.tsx: DaVinci core collector
 *
 * Renders a masked input for PASSWORD and PASSWORD_VERIFY collectors.
 * Submit key: collector.key. Payload value: string.
 * The bridge never returns the password value in node output, so the field
 * starts empty.
 */

import React from 'react';
import type {
  DaVinciFormValue,
  PasswordCollector,
} from '@ping-identity/rn-davinci';
import { PingSecureField } from '../theme/PingTheme';

type Props = {
  collector: PasswordCollector;
  value: DaVinciFormValue | undefined;
  onChange: (value: string) => void;
};

/**
 * Renders a masked input for a PASSWORD or PASSWORD_VERIFY collector.
 *
 * @returns The secure field element.
 */
export function PasswordCollectorView({
  collector,
  value,
  onChange,
}: Props): React.ReactElement {
  return (
    <PingSecureField
      label={collector.required ? `${collector.label} *` : collector.label}
      value={typeof value === 'string' ? value : ''}
      onChangeText={onChange}
      placeholder={collector.label}
    />
  );
}
