import SwiftUI
import PingDavinci

/// Renders radio buttons for a SingleSelectCollector with type "RADIO".
struct RadioButtonView: View {
    let collector: SingleSelectCollector
    @State private var selected: String = ""

    var body: some View {
        VStack(alignment: .leading, spacing: 4) {
            Text(collector.label)
                .font(.caption)
                .foregroundColor(.secondary)

            ForEach(collector.options, id: \.value) { option in
                Button(action: {
                    selected = option.value
                    collector.value = option.value
                }) {
                    HStack {
                        Image(systemName: selected == option.value ? "circle.inset.filled" : "circle")
                            .foregroundColor(selected == option.value ? .accentColor : .secondary)
                        Text(option.label)
                            .foregroundColor(.primary)
                    }
                }
                .buttonStyle(.plain)
            }
        }
        .onAppear {
            selected = collector.value
        }
    }
}
