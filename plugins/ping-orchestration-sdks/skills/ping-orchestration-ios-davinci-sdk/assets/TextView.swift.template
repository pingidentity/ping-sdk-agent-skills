import SwiftUI
import PingDavinci

/// Renders a text input field for a TextCollector.
struct TextView: View {
    let collector: TextCollector
    @EnvironmentObject var validationVM: ValidationViewModel
    @State private var text: String = ""
    @State private var errors: [String] = []

    var body: some View {
        VStack(alignment: .leading, spacing: 4) {
            TextField(collector.label, text: $text)
                .textFieldStyle(.roundedBorder)
                .autocapitalization(.none)
                .disableAutocorrection(true)
                .onChange(of: text) { newValue in
                    collector.value = newValue
                    if validationVM.shouldValidate {
                        errors = collector.validate().map { "\($0)" }
                    }
                }
                .onAppear {
                    text = collector.value
                }

            if validationVM.shouldValidate && !errors.isEmpty {
                ForEach(errors, id: \.self) { error in
                    Text(error)
                        .font(.caption)
                        .foregroundColor(.red)
                }
            }
        }
    }
}
