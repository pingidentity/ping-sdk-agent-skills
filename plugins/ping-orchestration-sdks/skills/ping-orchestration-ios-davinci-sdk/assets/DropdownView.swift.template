import SwiftUI
import PingDavinci

/// Renders a dropdown picker for a SingleSelectCollector with type "DROPDOWN".
struct DropdownView: View {
    let collector: SingleSelectCollector
    @State private var selected: String = ""

    var body: some View {
        VStack(alignment: .leading) {
            Text(collector.label)
                .font(.caption)
                .foregroundColor(.secondary)

            Picker(collector.label, selection: $selected) {
                ForEach(collector.options, id: \.value) { option in
                    Text(option.label).tag(option.value)
                }
            }
            .pickerStyle(.menu)
            .onChange(of: selected) { newValue in
                collector.value = newValue
            }
            .onAppear {
                selected = collector.value
            }
        }
    }
}
