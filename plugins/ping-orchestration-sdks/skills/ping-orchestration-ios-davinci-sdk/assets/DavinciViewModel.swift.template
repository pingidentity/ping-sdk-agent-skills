/*
 * DaVinci ViewModel — orchestrates the DaVinci authentication flow.
 *
 * INSTRUCTIONS:
 *   1. Place in YourApp/ViewModels/DavinciViewModel.swift
 *   2. Configure the `davinci` instance with your PingOne DaVinci details.
 */

import SwiftUI
import PingDavinci
import PingOrchestrate
import PingOidc

// ── DaVinci Instance ─────────────────────────────────────────────────────────

let davinci = DaVinci.createDaVinci { config in
    config.module(OidcModule.config) { oidcValue in
        oidcValue.clientId = "<your-client-id>"
        oidcValue.scopes = ["openid", "profile", "email"]
        oidcValue.redirectUri = "myapp://callback"
        oidcValue.discoveryEndpoint = "https://auth.pingone.com/<your-env-id>/as/.well-known/openid-configuration"
    }
}

// ── DaVinci State ────────────────────────────────────────────────────────────

class DavinciState {
    var previous: Node? = nil
    var node: Node? = nil
}

// ── ViewModel ────────────────────────────────────────────────────────────────

@MainActor
class DavinciViewModel: ObservableObject {

    @Published var state: DavinciState = DavinciState()
    @Published var isLoading: Bool = false

    init() {
        Task {
            await start()
        }
    }

    /// Starts the DaVinci flow.
    func start() async {
        isLoading = true
        let node = await davinci.start()
        state.previous = nil
        state.node = node
        objectWillChange.send()
        isLoading = false
    }

    /// Advances to the next node by submitting the current ContinueNode's collectors.
    func next(_ node: ContinueNode) async {
        isLoading = true
        state.previous = node
        let next = await node.next()
        state.node = next
        objectWillChange.send()
        isLoading = false
    }

    /// Triggers a UI refresh without advancing the flow.
    func refresh() {
        objectWillChange.send()
    }

    /// Logs out the current user.
    func logout() async {
        let user = await davinci.user()
        await user?.logout()
    }
}
