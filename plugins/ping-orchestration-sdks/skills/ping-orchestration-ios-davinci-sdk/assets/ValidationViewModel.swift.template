/*
 * Validation ViewModel — shared state for coordinating form validation.
 *
 * INSTRUCTIONS:
 *   1. Place in YourApp/ViewModels/ValidationViewModel.swift
 *   2. Inject via .environmentObject(ValidationViewModel()) on a parent view.
 *   3. Collector views read `shouldValidate` to trigger validation display.
 */

import SwiftUI

/// Shared validation state injected as an @EnvironmentObject.
/// When a SubmitCollector is tapped, `shouldValidate` is set to true,
/// causing all ValidatedCollector views to display their validation errors.
class ValidationViewModel: ObservableObject {
    @Published var shouldValidate: Bool = false
}
