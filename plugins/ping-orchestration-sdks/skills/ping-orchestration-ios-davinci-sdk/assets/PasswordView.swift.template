import SwiftUI
import PingDavinci

/// Renders a secure password input for a PasswordCollector.
struct PasswordView: View {
    let collector: PasswordCollector
    @EnvironmentObject var validationVM: ValidationViewModel
    @State private var password: String = ""
    @State private var isVisible: Bool = false
    @State private var errors: [String] = []

    var body: some View {
        VStack(alignment: .leading, spacing: 4) {
            HStack {
                if isVisible {
                    TextField(collector.label, text: $password)
                        .textFieldStyle(.roundedBorder)
                        .autocapitalization(.none)
                        .disableAutocorrection(true)
                } else {
                    SecureField(collector.label, text: $password)
                        .textFieldStyle(.roundedBorder)
                }

                Button(action: { isVisible.toggle() }) {
                    Image(systemName: isVisible ? "eye.slash" : "eye")
                        .foregroundColor(.secondary)
                }
            }
            .onChange(of: password) { newValue in
                collector.value = newValue
                if validationVM.shouldValidate {
                    errors = collector.validate().map { "\($0)" }
                }
            }
            .onAppear {
                password = collector.value
            }

            if validationVM.shouldValidate && !errors.isEmpty {
                ForEach(errors, id: \.self) { error in
                    Text(error)
                        .font(.caption)
                        .foregroundColor(.red)
                }
            }
        }
    }
}
