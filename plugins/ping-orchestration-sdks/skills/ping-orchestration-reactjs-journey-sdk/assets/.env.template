# ── Ping Orchestration JavaScript SDK — Environment Configuration ──────────────
#
# INSTRUCTIONS:
#   1. Copy this file to .env in the project root
#   2. Fill in the values below with your PingAM / AIC tenant details
#   3. Restart the dev server after making changes
#

# OIDC well-known endpoint URL (required)
# e.g. https://your-tenant.forgeblocks.com/am/oauth2/alpha/.well-known/openid-configuration
VITE_WELLKNOWN_URL=

# OAuth 2.0 Client ID registered in PingAM / AIC (required)
VITE_WEB_OAUTH_CLIENT=

# OAuth 2.0 scopes — space-separated (required, must include "openid")
VITE_SCOPE=openid profile email

# Local development server port
VITE_PORT=8443

# OAuth 2.0 redirect URI registered in PingAM / AIC
# Must exactly match (including protocol and port) what is registered in the OAuth client.
# If omitted, defaults to ${window.location.origin}/callback.html at runtime.
VITE_REDIRECT_URI=http://localhost:8443/callback.html

# Journey/Tree name for login
VITE_JOURNEY_LOGIN=Login

# Journey/Tree name for registration (leave empty to disable registration)
VITE_JOURNEY_REGISTER=Registration

# Set to "true" to disable SDK debugger statements
VITE_DEBUGGER_OFF=true

# Centralized login mode — set to "true" to use redirect-based (centralized) login
# instead of embedded (journey-based) login
VITE_CENTRALIZED_LOGIN=false

# ── PingOne Protect (optional) ─────────────────────────────────────────────────
# Set VITE_INIT_PROTECT to "bootstrap" or "journey" to enable PingOne Protect
# "bootstrap" = initialize at app startup
# "journey" = initialize when PingOneProtectInitializeCallback is received
VITE_INIT_PROTECT=

# PingOne Environment ID — required if VITE_INIT_PROTECT is set
VITE_PINGONE_ENV_ID=
