/*
 * Password Callback Component
 *
 * INSTRUCTIONS:
 *   Place in client/components/journey/password.jsx
 *
 * Handles: PasswordCallback, ValidatedCreatePasswordCallback
 *
 * SDK integration points:
 *   - callback.getPrompt()        → label text
 *   - callback.getFailedPolicies() → server-side validation errors (JSON strings)
 *   - callback.getPolicies()      → policy requirements
 *   - callback.setPassword(val)   → set the password value
 */

import { useState } from 'react';

/**
 * @function Password — Renders a password input with visibility toggle
 * @param {Object} props
 * @param {Object} props.callback — The callback object from PingAM
 * @param {string} props.inputName — Unique input name for the field
 */
export default function Password({ callback, inputName }) {
  const passwordLabel = callback.getPrompt();
  const failedPolicies = callback.getFailedPolicies && callback.getFailedPolicies();
  const policies = callback.getPolicies && callback.getPolicies();
  const [isVisible, setVisibility] = useState(false);

  let isRequired = false;
  let validationMessage = '';

  if (failedPolicies?.length) {
    validationMessage = failedPolicies.reduce((prev, curr) => {
      let failureObj;
      try {
        failureObj = typeof curr === 'string' ? JSON.parse(curr) : curr;
      } catch {
        return `${prev}Please check this value for correctness. `;
      }

      switch (failureObj.policyRequirement) {
        case 'LENGTH_BASED':
          return `${prev}Ensure password contains more than ${failureObj.params?.['min-password-length'] || 8} characters. `;
        case 'CHARACTER_SET':
          return `${prev}Ensure password contains 1 of each: capital letter, number, and special character. `;
        default:
          return `${prev}Please check this value for correctness. `;
      }
    }, '');
  }

  if (policies?.policyRequirements) {
    isRequired = policies.policyRequirements.includes('REQUIRED');
  } else if (callback.isRequired) {
    isRequired = callback.isRequired();
  }

  function setValue(event) {
    callback.setPassword(event.target.value);
  }

  function toggleVisibility() {
    setVisibility(!isVisible);
  }

  return (
    <div style={{ marginBottom: '1rem' }}>
      <label htmlFor={inputName}>{passwordLabel}</label>
      <div style={{ display: 'flex', alignItems: 'center' }}>
        <input
          id={inputName}
          name={inputName}
          type={isVisible ? 'text' : 'password'}
          onChange={setValue}
          placeholder={passwordLabel}
          required={isRequired}
          style={{ flex: 1, padding: '0.5rem' }}
        />
        <button
          type="button"
          onClick={toggleVisibility}
          style={{ marginLeft: '0.5rem', padding: '0.5rem' }}
          aria-label={isVisible ? 'Hide password' : 'Show password'}
        >
          {isVisible ? '🙈' : '👁️'}
        </button>
      </div>
      {validationMessage && (
        <span style={{ color: 'red', fontSize: '0.875rem' }}>{validationMessage}</span>
      )}
    </div>
  );
}
