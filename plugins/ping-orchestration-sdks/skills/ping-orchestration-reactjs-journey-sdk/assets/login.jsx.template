/*
 * Login View
 *
 * INSTRUCTIONS:
 *   Place in client/views/login.jsx
 *
 * Renders the authentication form using the login Journey/Tree.
 * Supports both embedded login (default) and centralized (redirect) login.
 */

import { useContext, useEffect } from 'react';
import { Link, useNavigate } from 'react-router-dom';
import Form from '../components/journey/form';
import { OidcContext } from '../context/oidc.context';

/**
 * @function Login — React view for the login page
 *
 * Renders the Journey form. All token exchange logic lives in useJourney /
 * authorize.background() — the login view itself is just a shell.
 */
export default function Login() {
  const navigate = useNavigate();
  const [{ isAuthenticated }] = useContext(OidcContext);

  useEffect(() => {
    if (isAuthenticated) navigate('/');
  }, [isAuthenticated, navigate]);

  return (
    <div>
      <Form
        action={{ type: 'login' }}
        topMessage={
          <p>
            Don't have an account? <Link to="/register">Register here!</Link>
          </p>
        }
      />
    </div>
  );
}
