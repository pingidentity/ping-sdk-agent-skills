/*
 * KBA (Knowledge-Based Authentication) Callback Component
 *
 * INSTRUCTIONS:
 *   Place in client/components/journey/kba.jsx
 *
 * Handles: KbaCreateCallback
 *
 * SDK integration points:
 *   - callback.getPrompt()              → instruction text
 *   - callback.getPredefinedQuestions()  → array of security questions
 *   - callback.setQuestion(val)         → set the selected question
 *   - callback.setAnswer(val)           → set the answer
 */

/**
 * @function Kba — Renders security question selection and answer input
 * @param {Object} props
 * @param {Object} props.callback — The callback object from PingAM
 * @param {string} props.inputName — Unique input name for the field
 */
export default function Kba({ callback, inputName }) {
  const prompt = callback.getPrompt();
  const questions = callback.getPredefinedQuestions();

  function setQuestion(event) {
    callback.setQuestion(event.target.value);
  }

  function setAnswer(event) {
    callback.setAnswer(event.target.value);
  }

  return (
    <div style={{ marginBottom: '1rem', borderTop: '1px solid #ccc', paddingTop: '1rem' }}>
      <p style={{ fontWeight: 'bold' }}>Security Question</p>

      <div style={{ marginBottom: '0.5rem' }}>
        <label htmlFor={`${inputName}_question`}>{prompt}</label>
        <select
          id={`${inputName}_question`}
          onChange={setQuestion}
          required
          style={{ display: 'block', width: '100%', padding: '0.5rem' }}
        >
          <option value="">Select a question...</option>
          {questions.map((question, idx) => (
            <option key={idx} value={question}>
              {question}
            </option>
          ))}
        </select>
      </div>

      <div>
        <label htmlFor={`${inputName}_answer`}>Security Answer</label>
        <input
          id={`${inputName}_answer`}
          type="text"
          onChange={setAnswer}
          placeholder="Your answer"
          required
          style={{ display: 'block', width: '100%', padding: '0.5rem' }}
        />
      </div>
    </div>
  );
}
