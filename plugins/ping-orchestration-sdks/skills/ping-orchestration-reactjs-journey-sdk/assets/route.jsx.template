/*
 * Protected Route Component
 *
 * INSTRUCTIONS:
 *   Place in client/components/utilities/route.jsx
 *
 * Wraps routes that require authentication. If the user is not authenticated,
 * they are redirected to the /login page.
 */

import { useContext } from 'react';
import { Navigate } from 'react-router-dom';
import { OidcContext } from '../../context/oidc.context';

/**
 * @function ProtectedRoute — Guards child routes behind authentication
 * @param {Object} props
 * @param {JSX.Element} props.children — The protected content
 */
export function ProtectedRoute({ children }) {
  const [{ isAuthenticated }] = useContext(OidcContext);

  if (!isAuthenticated) {
    return <Navigate to="/login" replace />;
  }

  return children;
}
