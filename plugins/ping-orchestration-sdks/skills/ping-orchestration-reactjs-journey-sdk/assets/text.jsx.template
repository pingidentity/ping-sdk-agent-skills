/*
 * Text Input Callback Component
 *
 * INSTRUCTIONS:
 *   Place in client/components/journey/text.jsx
 *
 * Handles: NameCallback, ValidatedCreateUsernameCallback, StringAttributeInputCallback
 *
 * SDK integration points:
 *   - callback.getPrompt()        → label text
 *   - callback.getInputValue()    → existing/default value
 *   - callback.getName()          → attribute name (e.g., 'mail' for email type)
 *   - callback.getFailedPolicies() → server-side validation errors
 *   - callback.getPolicies()      → policy requirements (e.g., REQUIRED)
 *   - callback.setInputValue(val) → set user input
 */

/**
 * @function Text — Renders a text input for name/username/string attribute callbacks
 * @param {Object} props
 * @param {Object} props.callback — The callback object from PingAM
 * @param {string} props.inputName — Unique input name for the field
 */
export default function Text({ callback, inputName }) {
  const existingValue = callback.getInputValue();
  const textInputLabel = callback.getPrompt();
  const attributeName = callback.getName && callback.getName();

  // Check for server-side validation failures
  const failedPolicies = callback.getFailedPolicies && callback.getFailedPolicies();
  const policies = callback.getPolicies && callback.getPolicies();

  let isRequired = false;
  let validationMessage = '';

  if (failedPolicies?.length) {
    validationMessage = failedPolicies.reduce((prev, failureObj) => {
      switch (failureObj.policyRequirement) {
        case 'VALID_USERNAME':
          return `${prev}Please choose a different username. `;
        case 'VALID_EMAIL_ADDRESS_FORMAT':
          return `${prev}Please use a valid email address. `;
        default:
          return `${prev}Please check this value for correctness. `;
      }
    }, '');
  }

  if (policies?.policyRequirements) {
    isRequired = policies.policyRequirements.includes('REQUIRED');
  } else if (callback.isRequired) {
    isRequired = callback.isRequired();
  }

  function setValue(event) {
    callback.setInputValue(event.target.value);
  }

  return (
    <div style={{ marginBottom: '1rem' }}>
      <label htmlFor={inputName}>{textInputLabel}</label>
      <input
        id={inputName}
        name={inputName}
        type={attributeName === 'mail' ? 'email' : 'text'}
        defaultValue={existingValue}
        onChange={setValue}
        placeholder={textInputLabel}
        required={isRequired}
        style={{ display: 'block', width: '100%', padding: '0.5rem' }}
      />
      {validationMessage && (
        <span style={{ color: 'red', fontSize: '0.875rem' }}>{validationMessage}</span>
      )}
    </div>
  );
}
